diff --git a/code/sdl/sdl_input.c b/code/sdl/sdl_input.c
--- a/code/sdl/sdl_input.c
+++ b/code/sdl/sdl_input.c
@@ -350,6 +350,24 @@
 	if (!mouseAvailable || !SDL_WasInit( SDL_INIT_VIDEO ) )
 		return;
 
+#ifdef __pyxis__
+	qboolean relative = isFullscreen || !in_nograb->integer;
+
+	// Native focus changes can revoke the lock independently of engine state.
+	if( relative && !SDL_GetRelativeMouseMode() )
+		mouseActive = qfalse;
+
+	if( SDL_SetRelativeMouseMode( relative ? SDL_TRUE : SDL_FALSE ) < 0 )
+	{
+		mouseActive = qfalse;
+		return;
+	}
+	SDL_SetWindowGrab( SDL_window, relative ? SDL_TRUE : SDL_FALSE );
+	if( !mouseActive || in_nograb->modified )
+		IN_GobbleMotionEvents();
+	in_nograb->modified = qfalse;
+	mouseActive = qtrue;
+#else
 	if( !mouseActive )
 	{
 		SDL_SetRelativeMouseMode( SDL_TRUE );
@@ -376,6 +394,7 @@
 	}
 
 	mouseActive = qtrue;
+#endif
 }
 
