include $(SDK)/share/pyxis.mk

.PHONY: all
all:
	cmake -S $(SOURCE) -B $(BUILD) -G "Unix Makefiles" -Wno-dev \
	  -DCMAKE_TOOLCHAIN_FILE=$(PYXIS_SDK)/share/pyxis.cmake \
	  -DPYXIS_CROSS_COMPILE=$(CROSS_COMPILE) \
	  -DPYXIS_PORT_DIR=$(RECIPE) \
	  -DCMAKE_BUILD_TYPE=Release \
	  -DPRODUCT_VERSION=1.36_pyxis_87a99d1820 \
	  -DCMAKE_FIND_ROOT_PATH="$(SDL2);$(SDL2_OSMESA);$(MESA)" \
	  -DBUILD_CLIENT=ON -DBUILD_SERVER=OFF \
	  -DBUILD_RENDERER_GL1=ON -DBUILD_RENDERER_GL2=OFF \
	  -DUSE_RENDERER_DLOPEN=OFF \
	  -DBUILD_GAME_LIBRARIES=OFF -DBUILD_GAME_QVMS=OFF \
	  -DUSE_INTERNAL_SDL=OFF -DUSE_INTERNAL_ZLIB=ON -DUSE_INTERNAL_JPEG=ON \
	  -DUSE_INTERNAL_OGG=ON -DUSE_INTERNAL_VORBIS=ON \
	  -DUSE_CODEC_VORBIS=ON -DUSE_CODEC_OPUS=OFF \
	  -DUSE_OPENAL=OFF -DUSE_HTTP=OFF -DUSE_VOIP=OFF -DUSE_MUMBLE=OFF
	$(MAKE) -C $(BUILD) -j16 ioquake3
