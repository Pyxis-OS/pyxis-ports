include $(SDK)/share/pyxis.mk
CMAKE_PYXIS_CFLAGS := $(filter-out -MMD -MP,$(PYXIS_CFLAGS))

.PHONY: all
all:
	cmake -S $(SOURCE) -B $(BUILD) -G "Unix Makefiles" \
	  -DCMAKE_TOOLCHAIN_FILE=$(PYXIS_SDK)/share/pyxis.cmake \
	  -DPYXIS_CROSS_COMPILE=$(CROSS_COMPILE) \
	  -DCMAKE_C_FLAGS="$(CMAKE_PYXIS_CFLAGS)" \
	  -DCMAKE_C_STANDARD=23 -DCMAKE_C_STANDARD_REQUIRED=ON \
	  -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS_RELEASE=-DNDEBUG \
	  -DCMAKE_POSITION_INDEPENDENT_CODE=OFF \
	  -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_INCLUDEDIR=include \
	  -DCMAKE_FIND_ROOT_PATH=$(SDL2) -DCMAKE_PREFIX_PATH=$(SDL2) \
	  -DBUILD_SHARED_LIBS=OFF -DSDL2MIXER_INSTALL=ON \
	  -DSDL2MIXER_VENDORED=OFF -DSDL2MIXER_DEPS_SHARED=OFF \
	  -DSDL2MIXER_SAMPLES=OFF -DSDL2MIXER_CMD=OFF \
	  -DSDL2MIXER_FLAC=OFF -DSDL2MIXER_GME=OFF \
	  -DSDL2MIXER_MOD=OFF -DSDL2MIXER_MP3=OFF \
	  -DSDL2MIXER_MIDI=OFF -DSDL2MIXER_OPUS=OFF \
	  -DSDL2MIXER_VORBIS=OFF -DSDL2MIXER_WAVPACK=OFF \
	  -DSDL2MIXER_WAVE=ON -DFETCHCONTENT_FULLY_DISCONNECTED=ON
	$(MAKE) -C $(BUILD) SDL2_mixer
