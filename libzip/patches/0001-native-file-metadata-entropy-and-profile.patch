diff --git a/lib/zip_random_unix.c b/lib/zip_random_unix.c
index 558d682..cf5c6e2 100644
--- a/lib/zip_random_unix.c
+++ b/lib/zip_random_unix.c
@@ -37,6 +37,25 @@
 #include "zip_crypto.h"
 #endif
 
+#ifdef __pyxis__
+#include <sys/random.h>
+
+bool zip_secure_random(zip_uint8_t *buffer, zip_uint16_t length) {
+    if (length == 0) {
+        return getentropy(buffer, 0) == 0;
+    }
+    while (length != 0) {
+        size_t count = length > 256 ? 256 : length;
+        if (getentropy(buffer, count) != 0) {
+            return false;
+        }
+        buffer += count;
+        length -= (zip_uint16_t)count;
+    }
+    return true;
+}
+
+#else
 #ifdef HAVE_ARC4RANDOM
 
 #include <stdlib.h>
@@ -104,3 +123,5 @@ zip_uint32_t zip_random_uint32(void) {
 #endif
 
 #endif /* HAVE_ARC4RANDOM */
+
+#endif /* __pyxis__ */
