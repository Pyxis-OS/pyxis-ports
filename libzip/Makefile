include $(SDK)/share/pyxis.mk
CMAKE_PYXIS_CFLAGS := $(filter-out -MMD -MP,$(PYXIS_CFLAGS))

.PHONY: all
all:
	cmake -S $(SOURCE) -B $(BUILD) -G "Unix Makefiles" \
	  -DCMAKE_TOOLCHAIN_FILE=$(PYXIS_SDK)/share/pyxis.cmake \
	  -DPYXIS_CROSS_COMPILE=$(CROSS_COMPILE) \
	  -DCMAKE_C_FLAGS="$(CMAKE_PYXIS_CFLAGS)" \
	  -DCMAKE_C_STANDARD=23 -DCMAKE_C_STANDARD_REQUIRED=ON \
	  -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS_RELEASE=-DNDEBUG \
	  -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_INCLUDEDIR=include \
	  -DCMAKE_FIND_ROOT_PATH=$(ZLIB) -DCMAKE_PREFIX_PATH=$(ZLIB) \
	  -DZLIB_INCLUDE_DIR=$(ZLIB)/include -DZLIB_LIBRARY=$(ZLIB)/lib/libz.a \
	  -DBUILD_SHARED_LIBS=OFF -DLIBZIP_DO_INSTALL=ON \
	  -DENABLE_BZIP2=OFF -DENABLE_LZMA=OFF -DENABLE_ZSTD=OFF \
	  -DENABLE_COMMONCRYPTO=OFF -DENABLE_GNUTLS=OFF \
	  -DENABLE_OPENSSL=OFF -DENABLE_WINDOWS_CRYPTO=OFF \
	  -DENABLE_FDOPEN=ON -DENABLE_COVERAGE=OFF \
	  -DBUILD_TOOLS=OFF -DBUILD_REGRESS=OFF -DBUILD_OSSFUZZ=OFF \
	  -DBUILD_EXAMPLES=OFF -DBUILD_DOC=OFF \
	  -DFETCHCONTENT_FULLY_DISCONNECTED=ON
	$(MAKE) -C $(BUILD)
