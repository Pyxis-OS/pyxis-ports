@@ -51,6 +51,7 @@
 #include "net.h"
 #include "sys.h"
 #include "zone.h"
+#include <stdio.h>
 #include <string.h>
 
 
@@ -743,6 +744,40 @@ static void COM_UseCustomPaths(i32 arg_num) {
     }
 }
 
+//
+// -writedir <path>
+// Generated files (savegames, screenshots, demos, config files) go to
+// <path>/<game directory name> instead, which is searched before the game
+// data. On Pyxis the data is read-only, so the default is home://.
+//
+static void COM_AddWriteDir(void) {
+    const char* writedir = NULL;
+    i32 i = COM_CheckParm("-writedir");
+    if (i && i < com_argc - 1) {
+        writedir = com_argv[i + 1];
+    }
+#ifdef __pyxis__
+    if (!writedir) {
+        writedir = "home://chocolate-quake";
+    }
+#endif
+    if (!writedir) {
+        return;
+    }
+    const char* game = strrchr(com_gamedir, '/');
+    game = game ? game + 1 : com_gamedir;
+    char dir[MAX_OSPATH];
+    snprintf(dir, sizeof(dir), "%s/%s", writedir, game);
+    Sys_mkdir((char*) writedir);
+    Sys_mkdir(dir);
+    Q_strcpy(com_gamedir, dir);
+
+    searchpath_t* search = Hunk_Alloc(sizeof(*search));
+    Q_strcpy(search->filename, dir);
+    search->next = com_searchpaths;
+    com_searchpaths = search;
+}
+
