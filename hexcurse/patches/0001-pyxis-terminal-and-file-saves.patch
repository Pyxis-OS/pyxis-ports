+
+int editor_file_size(FILE *stream, off_t *length)
+{
+    struct stat info;
+    if (fstat(fileno(stream), &info) != 0)
+        return -1;
+    if (!S_ISREG(info.st_mode)) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    if (fseeko(stream, 0, SEEK_END) != 0 || (*length = ftello(stream)) < 0)
+        return -1;
+    return fseeko(stream, 0, SEEK_SET);
+}
