+#ifdef __pyxis__
+static enum call_status begin_runtime (char **argv, int script, int optlim,
+                                       int interactive) {
+  enum program_runtime_mode mode = PROGRAM_RUNTIME_POSITIONAL;
+  enum call_status status;
+  struct resource_result self = {0};
+  if (script > 0) {
+    const char *filename = argv[script];
+    if (strcmp(filename, "-") != 0 || strcmp(argv[script-1], "--") == 0) {
+      handle_t handed = HANDLE_INVALID;
+      status = environment_capability(startup_environment_handle(), "script", &handed);
+      if (status == CALL_OK) {
+        mode = PROGRAM_RUNTIME_HANDED;
+        handle_close(handed);
+      }
+      else if (status != CALL_NOT_FOUND)
+        return status;
+    }
+  }
+  else if (interactive) {
+    int i;
+    mode = PROGRAM_RUNTIME_INTERACTIVE;
+    for (i = 1; i < optlim; i++) {
+      if (argv[i][1] == 'e' || argv[i][1] == 'l') {
+        mode = PROGRAM_RUNTIME_POSITIONAL;
+        break;
+      }
+    }
+  }
+  status = resource_open_native_file_path(NULL, "app://bin/lua5.1.pxe",
+      PROVIDER_INTENT_READ, 0, &self);
+  if (status == CALL_OK)
+    status = resource_outcome_status(self.info.description.outcome);
+  if (status == CALL_NOT_FOUND || status == CALL_UNAVAILABLE)
+    status = CALL_OK;
+  if (status == CALL_OK)
+    status = program_runtime_begin(PROGRAM_INTERPRETER_LUA51, mode,
+        self.resource, HANDLE_INVALID, HANDLE_INVALID);
+  resource_result_close(&self);
+  return status;
+}
+#endif
