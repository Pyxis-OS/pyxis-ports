@@ -7,6 +7,7 @@
 
 #include <errno.h>
 #include <stdio.h>
+#include <pyxis/resource.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -22,6 +23,36 @@
 
 #define IO_INPUT	1
 #define IO_OUTPUT	2
+
+
+typedef struct IOShutdown {
+  int normal;
+  int failed;
+  int *shutdown_failed;  /* borrowed only through lua_close */
+} IOShutdown;
+
+static const char io_shutdown_key = 0;
+
+
+static IOShutdown *io_shutdown (lua_State *L) {
+  IOShutdown *shutdown;
+  lua_pushlightuserdata(L, (void *)&io_shutdown_key);
+  lua_rawget(L, LUA_REGISTRYINDEX);
+  shutdown = (IOShutdown *)lua_touserdata(L, -1);
+  lua_pop(L, 1);
+  return shutdown;
+}
+
+
+LUALIB_API void lua_pyxis_io_shutdown (lua_State *L, int normal, int *failed) {
+  IOShutdown *shutdown = io_shutdown(L);
+  if (failed != NULL)
+    *failed = shutdown != NULL && shutdown->failed;
+  if (shutdown != NULL) {
+    shutdown->normal = normal;
+    shutdown->shutdown_failed = failed;
+  }
+}
 
 
 static const char *const fnames[] = {"input", "output"};
@@ -129,10 +160,37 @@
 
 
 static int io_gc (lua_State *L) {
-  FILE *f = *tofilep(L);
-  /* ignore closed files */
-  if (f != NULL)
-    aux_close(L);
+  FILE **p = tofilep(L);
+  IOShutdown *shutdown;
+  lua_CFunction close;
+  int result, error;
+  if (*p == NULL)
+    return 0;
+  lua_getfenv(L, 1);
+  lua_getfield(L, -1, "__close");
+  close = lua_tocfunction(L, -1);
+  lua_pop(L, 2);
+  if (close == &io_noclose)
+    return 0;
+  if (close != &io_fclose) {
+    aux_close(L);  /* preserve other C FILE owners' close callbacks */
+    return 0;
+  }
+  shutdown = io_shutdown(L);
+  errno = 0;
+  result = shutdown != NULL && shutdown->normal ? fclose(*p) :
+           pyxis_fclose_abandon(*p);
+  error = errno;
+  *p = NULL;
+  if (result != 0) {
+    if (shutdown != NULL) {
+      shutdown->failed = 1;
+      if (shutdown->shutdown_failed != NULL)
+        *shutdown->shutdown_failed = 1;
+    }
+    fprintf(stderr, "lua: file cleanup failed (errno %d)\n",
+            error != 0 ? error : EIO);
+  }
   return 0;
 }
 
