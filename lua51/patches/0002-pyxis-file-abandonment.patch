diff --git a/src/liolib.c b/src/liolib.c
index 649f9a5..bd21bfa 100644
--- a/src/liolib.c
+++ b/src/liolib.c
@@ -7,6 +7,7 @@
 
 #include <errno.h>
 #include <stdio.h>
+#include <pyxis/resource.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -24,6 +25,31 @@
 #define IO_OUTPUT	2
 
 
+typedef struct IOShutdown {
+  int normal;
+} IOShutdown;
+
+static const char io_shutdown_key = 0;
+
+
+static IOShutdown *io_shutdown (lua_State *L) {
+  IOShutdown *shutdown;
+  lua_pushlightuserdata(L, (void *)&io_shutdown_key);
+  lua_rawget(L, LUA_REGISTRYINDEX);
+  shutdown = (IOShutdown *)lua_touserdata(L, -1);
+  lua_pop(L, 1);
+  return shutdown;
+}
+
+
+LUALIB_API void lua_pyxis_io_shutdown (lua_State *L, int normal) {
+  IOShutdown *shutdown = io_shutdown(L);
+  if (shutdown != NULL) {
+    shutdown->normal = normal;
+  }
+}
+
+
 static const char *const fnames[] = {"input", "output"};
 
 
@@ -140,10 +166,27 @@ static int io_close (lua_State *L) {
 
 
 static int io_gc (lua_State *L) {
-  FILE *f = *tofilep(L);
-  /* ignore closed files */
-  if (f != NULL)
-    aux_close(L);
+  FILE **p = tofilep(L);
+  IOShutdown *shutdown;
+  lua_CFunction close;
+  if (*p == NULL)
+    return 0;
+  lua_getfenv(L, 1);
+  lua_getfield(L, -1, "__close");
+  close = lua_tocfunction(L, -1);
+  lua_pop(L, 2);
+  if (close == &io_noclose)
+    return 0;
+  if (close != &io_fclose) {
+    aux_close(L);  /* preserve other C FILE owners' close callbacks */
+    return 0;
+  }
+  shutdown = io_shutdown(L);
+  if (shutdown != NULL && shutdown->normal)
+    fclose(*p);
+  else
+    pyxis_fclose_abandon(*p);
+  *p = NULL;
   return 0;
 }
 
@@ -535,6 +578,13 @@ static void newfenv (lua_State *L, lua_CFunction cls) {
 
 
 LUALIB_API int luaopen_io (lua_State *L) {
+  IOShutdown *shutdown = io_shutdown(L);
+  if (shutdown == NULL) {
+    lua_pushlightuserdata(L, (void *)&io_shutdown_key);
+    shutdown = (IOShutdown *)lua_newuserdata(L, sizeof(IOShutdown));
+    shutdown->normal = 0;
+    lua_rawset(L, LUA_REGISTRYINDEX);
+  }
   createmeta(L);
   /* create (private) environment (with fields IO_INPUT, IO_OUTPUT, __close) */
   newfenv(L, io_fclose);
