+/*
+ *  Pyxis has no BSD sockets or resolver, and its libuv reports sockets and
+ *  address conversion as unsupported and omits file watches. These replace
+ *  dns.c, tcp.c, udp.c, fs_event.c and fs_poll.c: each function keeps its Lua
+ *  name and reports ENOSYS like any libuv error, before touching a handle.
+ */
+#include "private.h"
+
+/* Also used by pipe connections; as in tcp.c. */
+static void luv_connect_cb(uv_connect_t* req, int status) {
+  luv_req_t* data = (luv_req_t*)req->data;
+  lua_State* L = data->ctx->L;
+  luv_status(L, status);
+  luv_fulfill_req(L, (luv_req_t*)req->data, 1);
+  luv_cleanup_req(L, (luv_req_t*)req->data);
+  req->data = NULL;
+}
+
