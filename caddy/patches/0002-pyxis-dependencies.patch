@@ -0,0 +1,47 @@
+// Copyright 2026 PyxisOS contributors. All rights reserved.
+// Use of this source code is governed by the MIT license
+// that can be found in the LICENSE file.
+
+package readline
+
+import (
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+)
+
+type State = syscall.TerminalState
+
+func IsTerminal(fd int) bool { return syscall.TerminalIsTerminal(fd) }
+func DefaultIsTerminal() bool {
+	return IsTerminal(int(os.Stdin.Fd())) && (IsTerminal(int(os.Stdout.Fd())) || IsTerminal(int(os.Stderr.Fd())))
+}
+func MakeRaw(fd int) (*State, error)         { return syscall.TerminalMakeRaw(fd) }
+func GetState(fd int) (*State, error)        { return syscall.TerminalGetState(fd) }
+func restoreTerm(fd int, state *State) error { return syscall.TerminalRestore(fd, state) }
+func ReadPassword(int) ([]byte, error)       { return nil, syscall.ENOSYS }
+func GetStdin() int                          { return int(os.Stdin.Fd()) }
+func GetScreenWidth() int {
+	columns, _, _, err := syscall.TerminalSize(int(os.Stdout.Fd()))
+	if err != nil {
+		columns, _, _, err = syscall.TerminalSize(int(os.Stderr.Fd()))
+	}
+	if err != nil {
+		return -1
+	}
+	return columns
+}
+func DefaultOnWidthChanged(func())         {}
+func ClearScreen(w io.Writer) (int, error) { return w.Write([]byte("\033[H")) }
+func SuspendMe()                           { panic("readline: process suspension is unsupported on Pyxis") }
+
+func CaptureExitSignal(f func()) {
+	ch := make(chan os.Signal, 1)
+	signal.Notify(ch, os.Interrupt)
+	go func() {
+		for range ch {
+			f()
+		}
+	}()
+}
