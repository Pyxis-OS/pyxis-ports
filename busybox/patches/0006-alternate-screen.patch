diff --git a/editors/vi.c b/editors/vi.c
index 51b7c03..2712229 100644
--- a/editors/vi.c
+++ b/editors/vi.c
@@ -5031,8 +5031,8 @@ int vi_main(int argc, char **argv)
 		}
 	}
 #endif
-	// Pyxis has no alternate screen buffer: clear the screen instead
-	write1(ESC_SET_CURSOR_TOPLEFT ESC_CLEAR2EOS);
+	// "Save cursor, use alternate screen buffer, clear screen"
+	write1(ESC"[?1049h");
 	// This is the main file handling loop
 	optind = 0;
 	while (1) {
@@ -5042,8 +5042,8 @@ int vi_main(int argc, char **argv)
 		if (optind >= cmdline_filecnt)
 			break;
 	}
-	// No alternate screen to leave: clear the editor from the screen
-	write1(ESC_SET_CURSOR_TOPLEFT ESC_CLEAR2EOS);
+	// "Use normal screen buffer, restore cursor"
+	write1(ESC"[?1049l");
 
 	return 0;
 }
