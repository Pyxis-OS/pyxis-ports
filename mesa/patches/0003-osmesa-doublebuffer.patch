+/*
+ * Pyxis extension: finish rendering and copy the front color image into the
+ * buffer supplied to OSMesaMakeCurrent, using OSMesaPixelStore's layout.
+ * For OSMESA_DOUBLEBUFFER contexts, exchange the front and back resources
+ * first.  The back contents are undefined after a swap.  Single-buffered
+ * contexts finish and copy their front image without exchanging resources.
+ *
+ * The context must be current on the calling thread.  Returns GL_FALSE for
+ * an invalid binding, failed completion or failed readback; on failure the
+ * color resources may already have been exchanged.  Returns GL_TRUE only
+ * after copying the image.  The supplied CPU buffer remains caller-owned.
+ */
+GLAPI GLboolean APIENTRY
+OSMesaSwapBuffers( OSMesaContext ctx );
 
 
 
