+/**
+ * Finish rendering, exchange color resources and snapshot the new front.
+ */
+GLAPI GLboolean GLAPIENTRY
+OSMesaSwapBuffers(OSMesaContext osmesa)
+{
+   if (!osmesa || OSMesaGetCurrentContext() != osmesa || !osmesa->current_buffer)
+      return GL_FALSE;
+
+   struct osmesa_buffer *osbuffer = osmesa->current_buffer;
+   struct pipe_fence_handle *fence = NULL;
+   struct pipe_screen *screen = osmesa->st->screen;
+
+   st_context_flush(osmesa->st, ST_FLUSH_END_OF_FRAME, &fence, NULL, NULL);
+   if (fence) {
+      bool finished = screen->fence_finish(screen, NULL, fence,
+                                           OS_TIMEOUT_INFINITE);
+      screen->fence_reference(screen, &fence, NULL);
+      if (!finished)
+         return GL_FALSE;
+   }
+
+   if (osmesa->double_buffer) {
+      struct pipe_resource *front = osbuffer->textures[ST_ATTACHMENT_FRONT_LEFT];
+      osbuffer->textures[ST_ATTACHMENT_FRONT_LEFT] =
+         osbuffer->textures[ST_ATTACHMENT_BACK_LEFT];
+      osbuffer->textures[ST_ATTACHMENT_BACK_LEFT] = front;
+      p_atomic_inc(&osbuffer->base.stamp);
+      st_context_invalidate_state(osmesa->st, ST_INVALIDATE_FB_STATE);
+   }
+
+   return osmesa_st_framebuffer_flush_front(osmesa->st, &osbuffer->base,
+                                            ST_ATTACHMENT_FRONT_LEFT);
 }
 
 
