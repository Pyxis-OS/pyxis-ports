+    char *temp_savegame_file = P_TempSaveGameFile();
+    long length;
+
     gameaction = ga_nothing;
-    players[consoleplayer].message = "SAVE/LOAD UNAVAILABLE IN THIS PORT";
-} 
- 
+    if (temp_savegame_file == NULL)
+    {
+        goto failed;
+    }
+
+    save_stream = fopen(temp_savegame_file, "wb");
+    if (save_stream == NULL)
+    {
+        perror("Doom: open temporary save");
+        goto failed;
+    }
+
+    savegame_error = false;
+    P_WriteSaveGameHeader(savedescription);
+    P_ArchivePlayers ();
+    P_ArchiveWorld ();
+    P_ArchiveThinkers ();
+    P_ArchiveSpecials ();
+    P_WriteSaveGameEOF();
+
+    length = ftell(save_stream);
+    if (length < 0 || ferror(save_stream))
+    {
+        savegame_error = true;
+    }
+    if (vanilla_savegame_limit && length > SAVEGAMESIZE)
+    {
+        fprintf(stderr, "Doom: save exceeds the vanilla size limit\n");
+        savegame_error = true;
+    }
+    if (fclose(save_stream) != 0)
+    {
+        perror("Doom: close temporary save");
+        savegame_error = true;
+    }
+    save_stream = NULL;
+    if (savegame_error)
+    {
+        goto failed;
+    }
+
+    // Publish only a complete, closed save. Failure leaves the old slot intact.
+    if (rename(temp_savegame_file, savegame_file) != 0)
+    {
+        perror("Doom: replace save");
+        goto failed;
+    }
+
+    free(temp_savegame_file);
+    M_StringCopy(savedescription, "", sizeof(savedescription));
+    players[consoleplayer].message = DEH_String(GGSAVED);
+    R_FillBackScreen ();
+    return;
+
+failed:
+    if (temp_savegame_file != NULL)
+    {
+        if (remove(temp_savegame_file) != 0)
+        {
+            perror("Doom: remove failed temporary save");
+        }
+        free(temp_savegame_file);
+    }
+    M_StringCopy(savedescription, "", sizeof(savedescription));
+    players[consoleplayer].message = "SAVE FAILED - PREVIOUS SAVE UNCHANGED";
+    fprintf(stderr, "Doom: save failed; previous slot unchanged\n");
+}
