diff --git a/include/SDL_mouse.h b/include/SDL_mouse.h
--- a/include/SDL_mouse.h
+++ b/include/SDL_mouse.h
@@ -441,7 +441,7 @@
  * - Button 2: Middle mouse button
  * - Button 3: Right mouse button
  */
-#define SDL_BUTTON(X)       (1 << ((X)-1))
+#define SDL_BUTTON(X)       (1u << ((X)-1))
 #define SDL_BUTTON_LEFT     1
 #define SDL_BUTTON_MIDDLE   2
 #define SDL_BUTTON_RIGHT    3
diff --git a/src/events/SDL_mouse.c b/src/events/SDL_mouse.c
--- a/src/events/SDL_mouse.c
+++ b/src/events/SDL_mouse.c
@@ -885,6 +885,7 @@
     SDL_Mouse *mouse = SDL_GetMouse();
     int posted;
     int integral_x, integral_y;
+    SDL_bool reset_on_direction_change = SDL_TRUE;
 
     if (window) {
         SDL_SetMouseFocus(window);
@@ -894,11 +895,17 @@
         return 0;
     }
 
-    if (x > 0.0f) {
+#ifdef SDL_VIDEO_DRIVER_PYXIS
+    if (SDL_UsesPyxisPointer()) {
+        /* Native signed fractions cancel until the destination changes. */
+        reset_on_direction_change = SDL_FALSE;
+    }
+#endif
+    if (x > 0.0f && reset_on_direction_change) {
         if (mouse->accumulated_wheel_x < 0.0f) {
             mouse->accumulated_wheel_x = 0.0f;
         }
-    } else if (x < 0.0f) {
+    } else if (x < 0.0f && reset_on_direction_change) {
         if (mouse->accumulated_wheel_x > 0.0f) {
             mouse->accumulated_wheel_x = 0.0f;
         }
@@ -913,11 +920,11 @@
     }
     mouse->accumulated_wheel_x -= integral_x;
 
-    if (y > 0.0f) {
+    if (y > 0.0f && reset_on_direction_change) {
         if (mouse->accumulated_wheel_y < 0.0f) {
             mouse->accumulated_wheel_y = 0.0f;
         }
-    } else if (y < 0.0f) {
+    } else if (y < 0.0f && reset_on_direction_change) {
         if (mouse->accumulated_wheel_y > 0.0f) {
             mouse->accumulated_wheel_y = 0.0f;
         }
