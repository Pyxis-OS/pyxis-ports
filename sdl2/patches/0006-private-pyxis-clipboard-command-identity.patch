+int SDL_SendKeyboardKeyWithClipboard(Uint8 state, SDL_Scancode scancode, Uint64 id, bool shared)
+{
+    int posted;
+    if (shared) {
+        SDL_Event event;
+        SDL_zero(event);
+        event.key.type = SDL_KEYDOWN;
+        event.key.state = SDL_PRESSED;
+        event.key.keysym.scancode = scancode;
+        event.key.keysym.sym = SDL_keyboard.keymap[scancode];
+        event.key.keysym.mod = KMOD_CTRL;
+        event.key.windowID = SDL_keyboard.focus ? SDL_keyboard.focus->id : 0;
+        /* Shared is one system command, not a held application key. */
+        return SDL_GetEventState(SDL_KEYDOWN) == SDL_ENABLE &&
+               PYXIS_PushClipboardEvent(&event, id) > 0;
+    }
+    pyxis_clipboard_id = id;
+    posted = SDL_SendKeyboardKeyInternal(KEYBOARD_HARDWARE, state, scancode, SDLK_UNKNOWN);
+    pyxis_clipboard_id = 0;
+    return posted;
