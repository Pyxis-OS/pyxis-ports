include $(SDK)/share/pyxis.mk

CFLAGS := $(filter-out -MMD -MP -std=%,$(PYXIS_CFLAGS))
CXXFLAGS := $(filter-out -MMD -MP -std=%,$(PYXIS_CXXFLAGS))

.PHONY: all
all:
	cmake -S $(RECIPE)/native -B $(BUILD) -G "Unix Makefiles" \
	  -DCMAKE_TOOLCHAIN_FILE=$(PYXIS_SDK)/share/pyxis.cmake \
	  -DPYXIS_CROSS_COMPILE=$(CROSS_COMPILE) \
	  -DSOURCE=$(SOURCE) -DCMAKE_BUILD_TYPE=Release \
	  -DCMAKE_C_FLAGS="$(CFLAGS)" -DCMAKE_C_FLAGS_RELEASE=-DNDEBUG \
	  -DCMAKE_CXX_FLAGS="$(CXXFLAGS)" -DCMAKE_CXX_FLAGS_RELEASE=-DNDEBUG \
	  -DCMAKE_FIND_ROOT_PATH="$(DEPS)" -DCMAKE_PREFIX_PATH="$(DEPS)" \
	  -DFETCHCONTENT_FULLY_DISCONNECTED=ON
	$(MAKE) -C $(BUILD) -j16
