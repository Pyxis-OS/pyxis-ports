+struct ConfigDirectoryOwner {
+    handle_t handle = HANDLE_INVALID;
+    ConfigDirectoryOwner() = default;
+    ConfigDirectoryOwner(const ConfigDirectoryOwner&) = delete;
+    ConfigDirectoryOwner& operator=(const ConfigDirectoryOwner&) = delete;
+    ~ConfigDirectoryOwner() {
+        if (handle != HANDLE_INVALID) {
+            handle_close(handle);
+        }
+    }
+    int Close() {
+        const handle_t closing = handle;
+        handle = HANDLE_INVALID;
+        return handle_close(closing);
+    }
+};
+
+void SyncConfigParent(const std::string& path) {
+    const auto parent = ConfigParent(path);
+    std::vector<handle_t> directories(parent.size() + 1);
+    std::vector<char> component(parent.size() + 1);
+    struct path_workspace workspace{};
+    workspace.directories = directories.data();
+    workspace.directory_capacity = directories.size();
+    workspace.component = component.data();
+    workspace.component_capacity = component.size();
+    ConfigDirectoryOwner directory;
+    const auto opened = path_resolve_native(nullptr, parent.c_str(), DIRECTORY_KIND_DIRECTORY,
+                                           DIRECTORY_RIGHT_CREATE, &workspace, &directory.handle);
+    if (opened != CALL_OK) {
+        throw std::runtime_error("open config directory " + parent + ": native status " +
+                                 std::to_string(static_cast<unsigned>(opened)));
+    }
+    const auto synced = directory_sync(directory.handle);
+    const int closed = directory.Close();
+    if (synced != CALL_OK) {
+        throw std::runtime_error("sync config directory " + parent + ": native status " +
+                                 std::to_string(static_cast<unsigned>(synced)) +
+                                 (closed == 0 ? "" : "; directory close failed"));
+    }
+    if (closed != 0) {
+        throw std::runtime_error("close config directory " + parent + " failed");
+    }
+}
