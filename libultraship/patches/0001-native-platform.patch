+void Config::Reload() {
+    if (mPath == "None" || !Native::IsFile(mPath)) {
+        mIsNewInstance = true;
+        mFlattenedJson = nlohmann::json::object();
+        return;
+    }
+    std::unique_ptr<FILE, decltype(&fclose)> file(fopen(mPath.c_str(), "rb"), fclose);
+    if (!file) {
+        throw std::system_error(errno, std::generic_category(), "cannot read config " + mPath);
+    }
+    std::string contents;
+    char buffer[4096];
+    while (const auto count = fread(buffer, 1, sizeof(buffer), file.get())) {
+        contents.append(buffer, count);
+    }
+    if (ferror(file.get())) {
+        throw std::system_error(errno, std::generic_category(), "config read failed " + mPath);
+    }
+
+    mNestedJson = nlohmann::json::object();
+    mFlattenedJson = nlohmann::json::object();
+    try {
+        mNestedJson = nlohmann::json::parse(contents);
+        mFlattenedJson = mNestedJson.flatten();
+    } catch (const nlohmann::json::exception& e) {
+        SPDLOG_ERROR("Failed to parse config file {}: {}", mPath, e.what());
+    } catch (const std::exception& e) { SPDLOG_ERROR("Unexpected error loading config file {}: {}", mPath, e.what()); }
+}
+
+bool Config::Save() {
+    saveWasUncertain = false;
+    bool replacementAttempted = false;
+    std::string tempPath;
+    try {
+        mNestedJson = mFlattenedJson.unflatten();
+        const std::string contents = mNestedJson.dump(4);
+        tempPath = mPath + ".tmp";
+        std::unique_ptr<FILE, decltype(&fclose)> file(fopen(tempPath.c_str(), "wb"), fclose);
+        if (!file) {
+            ConfigSaveError(errno, "open config temporary", tempPath);
+        }
+        if (fwrite(contents.data(), 1, contents.size(), file.get()) != contents.size()) {
+            ConfigSaveError(errno, "write config temporary", tempPath);
+        }
+        if (fflush(file.get()) != 0) {
+            ConfigSaveError(errno, "flush config temporary", tempPath);
+        }
+        if (fsync(fileno(file.get())) != 0) {
+            ConfigSaveError(errno, "sync config temporary", tempPath);
+        }
+        if (fclose(file.release()) != 0) {
+            ConfigSaveError(errno, "close config temporary", tempPath);
+        }
+        replacementAttempted = true;
+        if (rename(tempPath.c_str(), mPath.c_str()) != 0) {
+            ConfigSaveError(errno, "replace config", mPath);
+        }
+        SyncConfigParent(mPath);
+        return true;
+    } catch (const std::exception& error) {
+        saveWasUncertain = replacementAttempted;
+        fprintf(stderr, "Could not save config %s: %s\n", mPath.c_str(), error.what());
+        if (!replacementAttempted && !tempPath.empty()) {
+            remove(tempPath.c_str());
+        }
+        return false;
+    }
