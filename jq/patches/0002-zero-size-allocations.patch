diff --git a/src/jv_alloc.c b/src/jv_alloc.c
index 40c244c..86281ce 100644
--- a/src/jv_alloc.c
+++ b/src/jv_alloc.c
@@ -137,8 +137,16 @@ static void memory_exhausted() {
 #endif /* USE_TLS */
 
 
+#ifdef PYXIS
+/* ISO C lets malloc, calloc and realloc return NULL for a zero size, as Pyxis
+ * libc does. jq reads NULL as exhaustion, so request one byte instead. */
+#define NONZERO(sz) ((sz) ? (sz) : 1)
+#else
+#define NONZERO(sz) (sz)
+#endif
+
 void* jv_mem_alloc(size_t sz) {
-  void* p = malloc(sz);
+  void* p = malloc(NONZERO(sz));
   if (!p) {
     memory_exhausted();
   }
@@ -146,11 +154,11 @@ void* jv_mem_alloc(size_t sz) {
 }
 
 void* jv_mem_alloc_unguarded(size_t sz) {
-  return malloc(sz);
+  return malloc(NONZERO(sz));
 }
 
 void* jv_mem_calloc(size_t nemb, size_t sz) {
-  void* p = calloc(nemb, sz);
+  void* p = nemb && sz ? calloc(nemb, sz) : calloc(1, 1);
   if (!p) {
     memory_exhausted();
   }
@@ -158,7 +166,7 @@ void* jv_mem_calloc(size_t nemb, size_t sz) {
 }
 
 void* jv_mem_calloc_unguarded(size_t nemb, size_t sz) {
-  return calloc(nemb, sz);
+  return nemb && sz ? calloc(nemb, sz) : calloc(1, 1);
 }
 
 char* jv_mem_strdup(const char *s) {
@@ -178,7 +186,7 @@ void jv_mem_free(void* p) {
 }
 
 void* jv_mem_realloc(void* p, size_t sz) {
-  p = realloc(p, sz);
+  p = realloc(p, NONZERO(sz));
   if (!p) {
     memory_exhausted();
   }
