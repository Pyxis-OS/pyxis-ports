diff --git a/src/util.c b/src/util.c
index de44fa6..36e0ce6 100644
--- a/src/util.c
+++ b/src/util.c
@@ -1256,3 +1256,24 @@ find_string(const unsigned char *bp, int *tgt, const char * const *n1,
     return NULL;
 }
 #endif
+
+#ifdef PYXIS
+#include <pyxis/environment.h>
+#include <stdint.h>
+
+/* Pyxis has no global environ array. Copy the process environment through
+ * libc's snapshot, which already holds consistent name and value strings. */
+jv jq_environment_object(void) {
+  struct pyxis_environment_snapshot snapshot;
+  if (pyxis_environment_snapshot_init(&snapshot) != CALL_OK)
+    return jv_invalid_with_msg(jv_string("cannot read the environment"));
+  jv env = jv_object();
+  for (size_t i = 0; i < snapshot.count; i++) {
+    const char *name = (const char *)(uintptr_t)snapshot.variables[i].name;
+    const char *value = (const char *)(uintptr_t)snapshot.variables[i].value;
+    env = jv_object_set(env, jv_string(name), jv_string(value));
+  }
+  pyxis_environment_snapshot_close(&snapshot);
+  return env;
+}
+#endif
