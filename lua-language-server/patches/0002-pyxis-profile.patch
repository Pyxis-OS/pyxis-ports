diff --git a/script/pyxis-profile.lua b/script/pyxis-profile.lua
new file mode 100644
index 0000000..2fef615
--- /dev/null
+++ b/script/pyxis-profile.lua
@@ -0,0 +1,53 @@
+-- The executable supplies immutable runtime and per-instance writable roots.
+local time = require 'bee.time'
+
+local m = {}
+
+function m.elapsed()
+    return time.monotonic() / 1000
+end
+
+-- Normalize components without treating ROOT:// as a POSIX path or crossing roots.
+function m.normalizePath(path)
+    assert(type(path) == 'string' and not path:find('%z'), 'invalid Pyxis path')
+    local root, rest = path:match('^([%w._+-]+)://(.*)$')
+    assert(not root or (root ~= '.' and root ~= '..'), 'invalid Pyxis root')
+    rest = rest or path
+    assert(rest:sub(1, 1) ~= '/', 'Pyxis paths need an explicit root')
+    local parts = {}
+    for part in rest:gmatch('[^/]+') do
+        if part == '..' then
+            if #parts > 0 and parts[#parts] ~= '..' then
+                parts[#parts] = nil
+            elseif root then
+                error('Pyxis path escapes its root: ' .. path)
+            else
+                parts[#parts+1] = part
+            end
+        elseif part ~= '.' then
+            parts[#parts+1] = part
+        end
+    end
+    local tail = table.concat(parts, '/')
+    return root and (root .. '://' .. tail) or tail
+end
+
+function m.isChild(path, root)
+    return path == root or (path:sub(1, #root) == root
+        and (root:sub(-1) == '/' or path:sub(#root + 1, #root + 1) == '/'))
+end
+
+local fixed = { ['Lua.format.enable'] = false }
+
+function m.fixedSetting(key)
+    if fixed[key] ~= nil then
+        return true, fixed[key]
+    end
+    return false
+end
+
+function m.unavailableDiagnostic(name)
+    return name == 'codestyle-check' or name == 'spell-check' or name == 'name-style-check'
+end
+
+return m
