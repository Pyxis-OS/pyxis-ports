+-- Relative milliseconds to the next live timer, including time since update.
+-- Native queue waiting uses this deadline; no permanent timer worker polls it.
+function m.nextTimeout()
+    local now = maxFrame + (monotonic() + fwFrame - lastClock)
+    local earliest
+    for frame, queue in pairs(timer) do
+        for _, t in pairs(queue) do
+            if t and not t._removed and t._running and not t._pauseRemaining then
+                if not earliest or frame < earliest then
+                    earliest = frame
+                end
+            end
+        end
+    end
+    return earliest and mathMax(0, mathCeil(earliest - now)) or nil
+end
+
 function m.timeJump(delta)
     fwFrame = fwFrame + mathFloor(delta * 1000.0)
 end
