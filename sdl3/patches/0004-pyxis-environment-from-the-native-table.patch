+#elif defined(__pyxis__)
+        // Pyxis keeps the environment in a native table and has no environ;
+        // copy the text values getenv() sees. Capability entries have no text.
+        struct pyxis_environment_snapshot snapshot;
+        if (pyxis_environment_text_snapshot_init(&snapshot) == CALL_OK) {
+            for (size_t i = 0; i < snapshot.capture.count; ++i) {
+                const struct environment_value *entry = &snapshot.capture.values[i];
+                char *variable = NULL;
+                if (!entry->text || SDL_asprintf(&variable, "%s=%s", entry->name, entry->text) < 0) {
+                    continue;
+                }
+                char *value = SDL_strchr(variable, '=');
+                *value++ = '\0';
+                SDL_InsertIntoHashTable(env->strings, variable, value, true);
+            }
+            pyxis_environment_snapshot_close(&snapshot);
+        }
