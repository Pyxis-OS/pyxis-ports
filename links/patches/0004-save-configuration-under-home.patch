 void init_home(void)
 {
 	get_system_name();
 	get_compiler_name();
+#ifdef PYXIS
+	/* Configuration lives in home://links/, made on first use. If it cannot
+	 * be found or made (no home root, or a read-only one), links_home stays
+	 * unset: nothing is loaded and saving reports that the home directory is
+	 * inaccessible. A directory that exists but is not writable fails later,
+	 * with the error of the failing open. */
+	{
+		struct stat st;
+		int rs;
+		EINTRLOOP(rs, stat("home://links", &st));
+		if (rs || !S_ISDIR(st.st_mode)) {
+			EINTRLOOP(rs, mkdir("home://links", 0700));
+		} else {
+			rs = 0;
+		}
+		if (!rs)
+			links_home = stracpy(cast_uchar "home://links/");
+	}
+#else
 	links_home = get_home(&first_use);
 	if (!links_home) {
 		fprintf(stderr, "Unable to find or create links config directory. Please check, that you have $HOME variable set correctly and that you have write permission to your home directory.\n\007");
 		portable_sleep(3000);
 		return;
 	}
+#endif
 }
 
