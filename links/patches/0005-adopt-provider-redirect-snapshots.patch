+int pyxis_get_cache_snapshot(struct cache_entry *alias, struct cache_entry **snapshot)
+{
+	unsigned char url[2049], *position;
+	struct cache_entry *e;
+	if (!alias->pyxis_redirect || strlen(cast_const_char alias->pyxis_redirect) >= sizeof url)
+		return -1;
+	strcpy(cast_char url, cast_const_char alias->pyxis_redirect);
+	if ((position = cast_uchar strchr(cast_const_char url, '#')))
+		*position = 0;
+	if (find_in_cache(url, &e))
+		return -1;
+	if (e->incomplete || e->redirect || e->pyxis_redirect) {
+		e->refcount--;
+		return -1;
+	}
+	*snapshot = e;
+	return 0;
+}
+
+int pyxis_adopt_cache_snapshot(struct status *stat, unsigned char **url, unsigned char **position)
+{
+	struct cache_entry *e;
+	unsigned char *u, *pos;
+	if (!stat->ce || !stat->ce->pyxis_redirect)
+		return 0;
+	if (pyxis_get_cache_snapshot(stat->ce, &e))
+		return -1;
+	/* Pin the body before allocations can invoke cache collection. */
+	u = stracpy(stat->ce->pyxis_redirect);
+	pos = extract_position(u);
+	if (pos) {
+		if (position) {
+			if (*position) mem_free(*position);
+			*position = pos;
+		} else mem_free(pos);
+	}
+	mem_free(*url);
+	*url = u;
+	stat->ce = e;
+	return 1;
+}
+#endif
 
