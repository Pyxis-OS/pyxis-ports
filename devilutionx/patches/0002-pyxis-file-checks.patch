diff --git a/Source/utils/file_util.cpp b/Source/utils/file_util.cpp
index 4c04d4b..51d7090 100644
--- a/Source/utils/file_util.cpp
+++ b/Source/utils/file_util.cpp
@@ -39,6 +39,12 @@
 #if defined(__APPLE__) && DARWIN_MAJOR_VERSION >= 9
 #include <copyfile.h>
 #endif
+
+#ifdef __pyxis__
+#include <cstdio>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
 
 // We include sys/stat.h for mkdir where available.
 #if !defined(DVL_HAS_FILESYSTEM) && defined(__has_include) && !defined(_WIN32)
@@ -78,7 +84,10 @@ string_view Dirname(string_view path)
 
 bool FileExists(const char *path)
 {
-#if defined(_WIN64) || defined(_WIN32)
+#if defined(__pyxis__)
+	struct ::stat statResult;
+	return ::stat(path, &statResult) == 0;
+#elif defined(_WIN64) || defined(_WIN32)
 #if defined(NXDK)
 	const bool exists = ::GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
 #else
@@ -149,7 +158,10 @@ DWORD WindowsGetFileAttributes(const char *path)
 
 bool DirectoryExists(const char *path)
 {
-#if defined(_WIN64) || defined(_WIN32)
+#if defined(__pyxis__)
+	struct ::stat statResult;
+	return ::stat(path, &statResult) == 0 && S_ISDIR(statResult.st_mode);
+#elif defined(_WIN64) || defined(_WIN32)
 	const DWORD attr = WindowsGetFileAttributes(path);
 	return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY) != 0;
 #elif defined(DVL_HAS_FILESYSTEM)
@@ -305,6 +317,13 @@ bool ResizeFile(const char *path, std::uintmax_t size)
 	return true;
 #elif _POSIX_C_SOURCE >= 200112L || defined(_BSD_SOURCE) || defined(__APPLE__)
 	return ::truncate(path, static_cast<off_t>(size)) == 0;
+#elif defined(__pyxis__)
+	FILE *file = std::fopen(path, "r+b");
+	if (file == nullptr)
+		return false;
+	const bool resized = ::ftruncate(fileno(file), static_cast<off_t>(size)) == 0;
+	std::fclose(file);
+	return resized;
 #else
 	static_assert(false, "truncate not implemented for the current platform");
 #endif
