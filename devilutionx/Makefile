include $(SDK)/share/pyxis.mk

# Single player without sound, as the patched Pyxis platform file selects.
# zlib, libpng, fmt and SDL2 are the Pyxis development libraries; the other
# dependencies are this recipe's pinned extra sources, so FetchContent never
# downloads anything.
.PHONY: all
all:
	cmake -S $(SOURCE) -B $(BUILD) -G "Unix Makefiles" -Wno-dev \
	  -DCMAKE_TOOLCHAIN_FILE=$(PYXIS_SDK)/share/pyxis.cmake \
	  -DPYXIS_CROSS_COMPILE=$(CROSS_COMPILE) \
	  -DCMAKE_BUILD_TYPE=Release \
	  "-DCMAKE_FIND_ROOT_PATH=$(ZLIB);$(LIBPNG);$(FMT);$(SDL2)" \
	  -DDEVILUTIONX_SYSTEM_ZLIB=ON -DDEVILUTIONX_SYSTEM_LIBPNG=ON \
	  -DDEVILUTIONX_SYSTEM_LIBFMT=ON \
	  -DDEVILUTIONX_SYSTEM_SDL2=ON -DDEVILUTIONX_STATIC_SDL2=ON \
	  -DDEVILUTIONX_SYSTEM_BZIP2=OFF -DDEVILUTIONX_SYSTEM_SDL_IMAGE=OFF \
	  -DDEVILUTIONX_SYSTEM_SIMPLEINI=OFF \
	  -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
	  -DFETCHCONTENT_SOURCE_DIR_BZIP2=$(BZIP2_SOURCE) \
	  -DFETCHCONTENT_SOURCE_DIR_LIBMPQ=$(LIBMPQ_SOURCE) \
	  -DFETCHCONTENT_SOURCE_DIR_LIBSMACKERDEC=$(LIBSMACKERDEC_SOURCE) \
	  -DFETCHCONTENT_SOURCE_DIR_SIMPLEINI=$(SIMPLEINI_SOURCE) \
	  -DFETCHCONTENT_SOURCE_DIR_SDL_IMAGE=$(SDL_IMAGE_SOURCE)
	$(MAKE) -C $(BUILD)
