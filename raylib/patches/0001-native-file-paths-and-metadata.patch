+#if defined(__pyxis__)
+#include <errno.h>
+#include <environment.h>
+#include <sys/stat.h>
+// Lexical scheme boundary only; this does not look up or prove a resource.
+static const char *GetNativeRootEnd(const char *path)
+{
+    if (path == NULL) return NULL;
+    const char *end = path;
+    while (*end && (*end != ':') && (*end != '/')) end++;
+    size_t length = end - path;
+    if (!length || (length > ENVIRONMENT_NAME_MAX) || strncmp(end, "://", 3)) return NULL;
+    char name[ENVIRONMENT_NAME_MAX + 1] = { 0 };
+    char checked[ENVIRONMENT_NAME_MAX + 1];
+    memcpy(name, path, length);
+    return environment_name(checked, name)? end + 3 : NULL;
+}
+
+static bool NativeDirectoryExists(const char *path)
+{
+    struct stat info = { 0 };
+    return (stat(path, &info) == 0) && S_ISDIR(info.st_mode);
+}
+#endif
