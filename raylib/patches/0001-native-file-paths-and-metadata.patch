 // Get previous directory path for a provided path
 const char *GetPrevDirectoryPath(const char *dirPath)
 {
+#if defined(__pyxis__)
+    static char previous[MAX_FILEPATH_LENGTH];
+    previous[0] = '\0';
+    if (dirPath == NULL) { errno = EINVAL; return previous; }
+    size_t length = strlen(dirPath);
+    if (length >= sizeof(previous)) { errno = ENAMETOOLONG; return previous; }
+    const char *root = GetNativeRootEnd(dirPath);
+    size_t minimum = root? (size_t)(root - dirPath) : 0;
+    if (IsPathFile(dirPath))
+    {
+        while ((length > minimum) && (dirPath[length - 1] == '/')) length--;
+        while ((length > minimum) && (dirPath[length - 1] != '/')) length--;
+        while ((length > minimum) && (dirPath[length - 1] == '/')) length--;
+    }
+    while ((length > minimum) && (dirPath[length - 1] == '/')) length--;
+    while ((length > minimum) && (dirPath[length - 1] != '/')) length--;
+    while ((length > minimum) && (dirPath[length - 1] == '/')) length--;
+    if (!length) { strcpy(previous, "."); return previous; }
+    memcpy(previous, dirPath, length);
+    previous[length] = '\0';
+    return previous;
+#else
     static char prevDirPath[MAX_FILEPATH_LENGTH] = { 0 };
     memset(prevDirPath, 0, MAX_FILEPATH_LENGTH);
 
@@ -2629,6 +2708,7 @@ const char *GetPrevDirectoryPath(const char *dirPath)
     }
 
     return prevDirPath;
+#endif
 }
 
