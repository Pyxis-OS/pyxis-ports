 // Create directories (including full path requested), returns 0 on success
 int MakeDirectory(const char *dirPath)
 {
+#if defined(__pyxis__)
+    if (!dirPath || !dirPath[0]) { errno = EINVAL; return -1; }
+    size_t length = strlen(dirPath);
+    if (length >= MAX_FILEPATH_LENGTH) { errno = ENAMETOOLONG; return -1; }
+    const char *root = GetNativeRootEnd(dirPath);
+    size_t start = root? (size_t)(root - dirPath) : 0;
+    if (!start && (dirPath[0] == '/' || strstr(dirPath, "://"))) { errno = EINVAL; return -1; }
+    if (start == length)
+    {
+        struct stat rootInfo = { 0 };
+        if (stat(dirPath, &rootInfo) != 0) return -1;
+        if (S_ISDIR(rootInfo.st_mode)) return 0;
+        errno = ENOTDIR;
+        return -1;
+    }
+    if (NativeDirectoryExists(dirPath)) return 0;
+    char *copy = RL_MALLOC(length + 1);
+    if (!copy) { errno = ENOMEM; return -1; }
+    memcpy(copy, dirPath, length + 1);
+    for (size_t i = start; i <= length; i++)
+    {
+        if (copy[i] && copy[i] != '/') continue;
+        if (i == start || (i && copy[i - 1] == '/')) continue;
+        char saved = copy[i];
+        copy[i] = '\0';
+        if ((mkdir(copy, 0777) != 0) && ((errno != EEXIST) || !NativeDirectoryExists(copy)))
+        {
+            RL_FREE(copy);
+            return -1;
+        }
+        copy[i] = saved;
+    }
+    RL_FREE(copy);
+    return 0;
+#else
     if ((dirPath == NULL) || (dirPath[0] == '\0')) return -1; // Path is not valid
     if (DirectoryExists(dirPath)) return 0; // Path already exists (is valid)
 
@@ -2842,6 +2957,7 @@ int MakeDirectory(const char *dirPath)
     if (!DirectoryExists(dirPath)) return -1;
 
     return 0;
+#endif
 }
 
