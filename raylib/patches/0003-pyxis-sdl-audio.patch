 static ma_result ma_thread_create__posix(ma_thread* pThread, ma_thread_priority priority, size_t stackSize, ma_thread_entry_proc entryProc, void* pData)
 {
+#if defined(__pyxis__)
+    pthread_attr_t attr;
+    int result;
+    if (priority != ma_thread_priority_normal) return MA_NOT_IMPLEMENTED;
+    if (pthread_attr_init(&attr) != 0) return MA_ERROR;
+    if (stackSize > 0 && pthread_attr_setstacksize(&attr, stackSize) != 0) {
+        pthread_attr_destroy(&attr);
+        return MA_INVALID_ARGS;
+    }
+    result = pthread_create(pThread, &attr, entryProc, pData);
+    pthread_attr_destroy(&attr);
+    return result == 0 ? MA_SUCCESS : MA_ERROR;
