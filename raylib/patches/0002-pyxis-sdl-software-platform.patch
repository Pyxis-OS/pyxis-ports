+#if defined(__pyxis__)
+static bool PyxisUpdateOutput(void)
+{
+    int width, height;
+    SDL_GetWindowSize(platform.window, &width, &height);
+    int logicalWidth = CORE.Window.screen.width;
+    int logicalHeight = CORE.Window.screen.height;
+    if ((width <= 0) || (height <= 0) || (logicalWidth <= 0) || (logicalHeight <= 0)) return false;
+    CORE.Window.display.width = width;
+    CORE.Window.display.height = height;
+    SDL_Rect *view = &platform.viewport;
+    if ((int64_t)width*logicalHeight <= (int64_t)height*logicalWidth)
+    {
+        view->w = width;
+        view->h = (int)((int64_t)width*logicalHeight/logicalWidth);
+    }
+    else
+    {
+        view->h = height;
+        view->w = (int)((int64_t)height*logicalWidth/logicalHeight);
+    }
+    if ((view->w <= 0) || (view->h <= 0)) return false;
+    view->x = (width - view->w)/2;
+    view->y = (height - view->h)/2;
+    return true;
+}
+
+static SDL_Surface *PyxisCreateCanvas(int width, int height)
+{
+    // rlsw stores framebuffer byte counts in signed int.
+    if ((width <= 0) || (height <= 0) || (width > INT_MAX/4) || (height > INT_MAX/(width*4)))
+    {
+        SDL_SetError("Invalid Pyxis logical canvas dimensions");
+        return NULL;
+    }
+    void *pixels = RL_MALLOC((size_t)width*height*4);
+    if (pixels == NULL) { SDL_OutOfMemory(); return NULL; }
+    // rlsw's default readback flips its bottom-up RGBA storage to top-down BGRA.
+    SDL_Surface *canvas = SDL_CreateRGBSurfaceWithFormatFrom(pixels, width, height, 32,
+        width*4, SDL_PIXELFORMAT_BGRA32);
+    if ((canvas == NULL) || (SDL_SetSurfaceBlendMode(canvas, SDL_BLENDMODE_NONE) != 0))
+    {
+        SDL_FreeSurface(canvas);
+        RL_FREE(pixels);
+        return NULL;
+    }
+    return canvas;
+}
+
+static void PyxisFreeCanvas(SDL_Surface *canvas)
+{
+    if (canvas == NULL) return;
+    void *pixels = canvas->pixels;
+    SDL_FreeSurface(canvas);
+    RL_FREE(pixels);
+}
+
+static void PyxisClearMouseButtons(void)
+{
+    memset(CORE.Input.Mouse.currentButtonState, 0, sizeof(CORE.Input.Mouse.currentButtonState));
+    memset(CORE.Input.Touch.currentTouchState, 0, sizeof(CORE.Input.Touch.currentTouchState));
+}
+
+static void PyxisMousePosition(int x, int y)
+{
+    SDL_Rect view = platform.viewport;
+    bool inside = (x >= view.x) && (y >= view.y) &&
+        (x < view.x + view.w) && (y < view.y + view.h);
+    CORE.Input.Mouse.cursorOnScreen = inside;
+    if (inside)
+    {
+        CORE.Input.Mouse.currentPosition = (Vector2){
+            (float)(x - view.x)*CORE.Window.screen.width/view.w,
+            (float)(y - view.y)*CORE.Window.screen.height/view.h };
+    }
+    else
+    {
+        CORE.Input.Mouse.currentPosition = (Vector2){ -1.0f, -1.0f };
+        PyxisClearMouseButtons();
+        CORE.Input.Mouse.currentWheelMove = (Vector2){ 0 };
+    }
+    CORE.Input.Touch.position[0] = CORE.Input.Mouse.currentPosition;
+}
+
+static void PyxisSyncMouseMode(void)
+{
+    bool locked = SDL_GetRelativeMouseMode() == SDL_TRUE;
+    if (locked != CORE.Input.Mouse.cursorLocked)
+    {
+        CORE.Input.Mouse.cursorLocked = locked;
+        CORE.Input.Mouse.currentPosition = (Vector2){ 0 };
+        CORE.Input.Mouse.previousPosition = (Vector2){ 0 };
+        PyxisClearMouseButtons();
+        if (!locked)
+        {
+            int x, y;
+            SDL_GetMouseState(&x, &y);
+            PyxisMousePosition(x, y);
+            CORE.Input.Mouse.previousPosition = CORE.Input.Mouse.currentPosition;
+        }
+    }
+    CORE.Input.Mouse.cursorHidden = locked || (SDL_ShowCursor(SDL_QUERY) == SDL_DISABLE);
+}
