+// Decimal places needed to show a step: ceil(-log10(step)), counted without
+// libm's logarithms, which Pyxis's libc doesn't provide.
+
+static int StepPrecision(float step)
+{
+    int precision = 0;
+    float scale = 1;
+
+    while (step > 0 && step * scale < 1 && precision < 9)
+    {
+        scale *= 10;
+        ++precision;
+    }
+
+    return precision;
+}
