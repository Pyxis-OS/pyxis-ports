@@ -339,7 +339,14 @@ boolean M_FileExists(const char *filename)
         // If we can't open because the file is a directory, the 
         // "file" exists at least!
 
+#ifdef __pyxis__
+        // Pyxis reports no EISDIR; ask whether a directory is there.
+        struct stat st;
