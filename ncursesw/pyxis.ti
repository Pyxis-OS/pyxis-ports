# Conservative Pyxis profile shared with Neovim task 3; no query or mouse modes.
pyxis|Pyxis native console and terminal sessions,
	am, bce, xenl,
	colors#16, cols#80, lines#24, pairs#256,
	cr=\r, cud1=\E[B, cub1=\E[D, cuf1=\E[C, cuu1=\E[A,
	home=\E[H, cup=\E[%i%p1%d;%p2%dH,
	clear=\E[H\E[2J, el=\E[K, ed=\E[J,
	csr=\E[%i%p1%d;%p2%dr,
	civis=\E[?25l, cnorm=\E[?25h,
	smcup=\E[?1049h, rmcup=\E[?1049l,
	rev=\E[7m, smso=\E[7m, rmso=\E[0m, sgr0=\E[0m,
	il1=\E[L, dl1=\E[M, il=\E[%p1%dL, dl=\E[%p1%dM,
	cud=\E[%p1%dB, cub=\E[%p1%dD, cuf=\E[%p1%dC, cuu=\E[%p1%dA,
	op=\E[39;49m,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e9%p1%{8}%-%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e10%p1%{8}%-%d%;m,
	kbs=^H, kdch1=\E[3~, khome=\E[H, kend=\E[F,
	knp=\E[6~, kpp=\E[5~, kcub1=\E[D, kcuf1=\E[C, kcuu1=\E[A, kcud1=\E[B,
