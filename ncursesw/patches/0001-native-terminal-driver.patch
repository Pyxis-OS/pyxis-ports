+      }
+    } else if (count == 0) {
+      errno = EIO;
+    }
+    state->output_error = errno;
+    return -1;
+  }
+}
+
+int
+_nc_pyxis_output_status(SCREEN *sp)
+{
+  struct native_terminal *state = native_state(TCBOf(sp));
+  if (state == NULL)
+    return ERR;
+  if (state->output_error) {
+    errno = state->output_error;
+    return ERR;
+  }
+  return OK;
+}
