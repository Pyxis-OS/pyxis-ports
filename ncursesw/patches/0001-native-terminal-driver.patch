+      errno = EIO;
+      return ERR;
+    }
+    if (events[1] & WAIT_RESIZED) {
+      sp->_sig_winch = TRUE;
+      return TW_NONE;
+    }
+    /* INPUT_LOST is readable/error: the ordinary descriptor read must
+    * acknowledge it and return the actual error, never consume a key. */
+    if (events[0] & (WAIT_READABLE | WAIT_PEER_FIN | WAIT_ERROR)) {
+      state->read_ready = true;
+      return TW_INPUT;
+    }
+    if (milliseconds == 0 || now >= end)
+      return TW_NONE;
+  }
