+
+int
+_nc_pyxis_read(SCREEN *sp, int *value)
+{
+  unsigned char byte;
+  struct native_terminal *state = native_state(TCBOf(sp));
+  *value = 0;
+  if (state == NULL || _nc_pyxis_output_status(sp) == ERR)
+    return -1;
+  bool may_wait = !state->read_ready;
+  state->read_ready = false;
+  for (;;) {
+    ssize_t count = pyxis_descriptor_try_read(sp->_ifd, &byte, 1);
+    if (count == 1) {
+      *value = byte;
+      return 1;
+    }
+    if (count == 0) {
+      errno = EIO;
+      return 0;
+    }
+    if (errno != EAGAIN || !may_wait)
+      return -1;
+    if (_nc_pyxis_wait(sp, -1, NULL) != TW_INPUT) {
+      if (sp->_sig_winch)
+        errno = EINTR;
+      return -1;
+    }
+    may_wait = false;
+    state->read_ready = false;
+  }
+}
+
+int
+_nc_pyxis_flush_input(SCREEN *sp)
+{
+  unsigned char bytes[256];
+  struct native_terminal *state = native_state(TCBOf(sp));
+  if (state == NULL)
+    return ERR;
+  state->read_ready = false;
+  state->escape_deadline = 0;
+  sp->_fifohead = -1;
+  sp->_fifotail = sp->_fifopeek = 0;
+  for (;;) {
+    ssize_t count = pyxis_descriptor_try_read(sp->_ifd, bytes, sizeof(bytes));
+    if (count < 0 && errno == EAGAIN)
+      return OK;
+    if (count <= 0)
+      return ERR;
+  }
+}
+
+int
+_nc_pyxis_escape_left(SCREEN *sp, int delay)
+{
+  struct native_terminal *state = native_state(TCBOf(sp));
+  uint64_t now;
+  if (state == NULL || native_now(&now) == ERR)
+    return 0;
+  if (!state->escape_deadline)
+    state->escape_deadline = (uint64_t)delay * 1000000 > UINT64_MAX - now ?
+      UINT64_MAX : now + (uint64_t)delay * 1000000;
+  return now >= state->escape_deadline ? 0 :
+    (int)((state->escape_deadline - now + 999999) / 1000000);
+}
+
+void
+_nc_pyxis_escape_end(SCREEN *sp)
+{
+  struct native_terminal *state = native_state(TCBOf(sp));
+  if (state != NULL)
+    state->escape_deadline = 0;
+}
+
+ssize_t
+_nc_pyxis_write(SCREEN *sp, const char *data, size_t size)
+{
+  struct native_terminal *state = native_state(TCBOf(sp));
+  if (state == NULL)
+    return -1;
+  if (state->output_error) {
+    errno = state->output_error;
+    return -1;
+  }
+  for (;;) {
+    ssize_t count = pyxis_descriptor_try_write(sp->_ofd, data, size);
+    if (count > 0 || (!size && count == 0))
+      return count;
+    if (count < 0 && errno == EAGAIN) {
+      uint64_t now, events = 0;
+      if (native_now(&now) != ERR) {
+        enum call_status status = pyxis_terminal_wait(sp->_ofd,
