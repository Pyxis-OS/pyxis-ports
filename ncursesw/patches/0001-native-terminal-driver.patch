+  uint64_t span = milliseconds < 0 ? 0 : (uint64_t)milliseconds * 1000000;
+  end = milliseconds < 0 || span > UINT64_MAX - now ? UINT64_MAX : now + span;
+  for (;;) {
+    uint64_t events[2] = {0};
+    struct pyxis_descriptor_binding input, output;
+    if (pyxis_descriptor_borrow(sp->_ifd, &input) != 0 ||
+      pyxis_descriptor_borrow(sp->_ofd, &output) != 0)
+      return ERR;
+    struct wait_interest interests[] = {
+      {.handle = input.handle, .events = WAIT_READABLE},
+      {.handle = output.handle, .events = WAIT_RESIZED,
+      .observed_generation = state->generation},
+    };
+    uint64_t deadline = milliseconds == 0 ? 0 :
+      (end - now > UINT64_C(30000000000) ? now + UINT64_C(30000000000) : end);
+    enum call_status status = wait_many(interests, 2,
+      input.buffered_read ? 0 : deadline, events);
+    if (status != CALL_OK && status != CALL_TIMED_OUT) {
+      errno = native_errno(status);
+      return ERR;
