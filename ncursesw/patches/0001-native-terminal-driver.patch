+#ifdef __pyxis__
+#include <pyxis/descriptor.h>
+#include <pyxis/terminal.h>
+#include <time.h>
+#include <wait.h>
+#endif
+#include <curses.priv.h>
+
+#ifdef __pyxis__
+#undef columns
+#undef lines
+
+struct native_terminal {
+  struct pyxis_terminal_state *saved;
+  struct pyxis_terminal_state *output_anchor;
+  int input;
+  int output;
+  bool read_ready;
+  TTY mode;
+  uint64_t generation;
+  uint64_t escape_deadline;
+  int output_error;
+};
+
+static struct native_terminal *
+native_state(TERMINAL_CONTROL_BLOCK *tcb)
+{
+  struct native_terminal *state = tcb->prop;
+  if (state == NULL) {
+    state = calloc(1, sizeof(*state));
+    if (state != NULL) {
+      state->input = -1;
+      state->output = tcb->term.Filedes;
+      if (pyxis_terminal_get_state(state->output, &state->output_anchor) != 0) {
+        int error = errno;
+        free(state);
+        errno = error;
+        return NULL;
+      }
+      tcb->prop = state;
+    }
+  }
+  if (state != NULL && state->output != tcb->term.Filedes) {
+    errno = EBADF;
+    return NULL;
+  }
+  if (state != NULL &&
+      (pyxis_terminal_state_validate(state->output, state->output_anchor) != 0 ||
+       (state->saved != NULL && pyxis_terminal_state_validate(state->input, state->saved) != 0)))
+    return NULL;
+  return state;
+}
+
+static int
+native_now(uint64_t *now)
+{
+  struct timespec value;
+  if (clock_gettime(CLOCK_MONOTONIC, &value) != 0)
+    return ERR;
+  *now = (uint64_t)value.tv_sec * UINT64_C(1000000000) + value.tv_nsec;
+  return OK;
+}
+
+static int
+native_errno(enum call_status status)
+{
+  switch (status) {
+  case CALL_BAD_HANDLE: return EBADF;
+  case CALL_DENIED: return EACCES;
+  case CALL_BUSY: return EBUSY;
+  case CALL_NO_MEMORY: return ENOMEM;
+  default: return EIO;
+  }
+}
+
+int
+_nc_pyxis_mode(TERMINAL_CONTROL_BLOCK *tcb, int set, TTY *mode)
+{
+  SCREEN *sp = tcb->csp;
+  struct native_terminal *state = native_state(tcb);
+  struct pyxis_descriptor_binding binding;
+  if (sp == NULL || state == NULL || mode == NULL)
+    return ERR;
+  if (pyxis_descriptor_borrow(sp->_ifd, &binding) != 0)
+    return ERR;
+  if (!(binding.access & PYXIS_DESCRIPTOR_READ)) {
+    errno = EACCES;
+    return ERR;
+  }
+  if (state->saved == NULL) {
+    if (pyxis_terminal_get_state(sp->_ifd, &state->saved) != 0)
+      return ERR;
+    state->input = sp->_ifd;
+  }
+  if (state->input != sp->_ifd) {
+    errno = EBADF;
+    return ERR;
+  }
+  if (!set) {
+    *mode = state->mode;
+    return OK;
+  }
+  if (mode->flags & ~(NC_PYXIS_RAW | NC_PYXIS_CBREAK)) {
+    errno = ENOTSUP;
+    return ERR;
+  }
+  if (mode->flags & NC_PYXIS_RAW) {
+    struct pyxis_terminal_state *previous;
+    if (pyxis_terminal_make_raw(state->input, &previous) != 0)
+      return ERR;
+    pyxis_terminal_state_free(previous);
+  } else if (pyxis_terminal_restore(state->input, state->saved) != 0) {
+    return ERR;
+  }
+  state->mode = *mode;
+  return OK;
+}
+
+int
+_nc_pyxis_release(TERMINAL_CONTROL_BLOCK *tcb)
+{
+  struct native_terminal *state = tcb->prop;
+  int result = OK;
+  if (state != NULL) {
+    if (state->saved != NULL) {
+      result = pyxis_terminal_restore(state->input, state->saved);
+      pyxis_terminal_state_free(state->saved);
+    }
+    pyxis_terminal_state_free(state->output_anchor);
+    free(state);
+    tcb->prop = NULL;
+  }
+  return result;
+}
+
+int
+_nc_pyxis_size(TERMINAL_CONTROL_BLOCK *tcb, int *height, int *width)
+{
+  struct console_size_reply size;
+  struct native_terminal *state = native_state(tcb);
+  if (state == NULL || pyxis_terminal_get_size(tcb->term.Filedes, &size) != 0)
+    return ERR;
+  if (!size.rows || !size.columns || size.rows > SHRT_MAX || size.columns > SHRT_MAX) {
+    errno = EOVERFLOW;
+    return ERR;
+  }
+  *height = (int)size.rows;
+  *width = (int)size.columns;
+  state->generation = size.generation;
+  return OK;
+}
+
+int
+_nc_pyxis_resize_pending(SCREEN *sp)
+{
+  struct native_terminal *state = native_state(TCBOf(sp));
+  if (state == NULL)
+    return FALSE;
+  if (!sp->_sig_winch) {
+    uint64_t events = 0;
+    enum call_status status = pyxis_terminal_wait(sp->_ofd, WAIT_RESIZED,
+        state->generation, 0, &events);
+    if (status != CALL_OK || (events & (WAIT_CLOSED | WAIT_ERROR))) {
+      state->output_error = status == CALL_OK ? EIO : native_errno(status);
+      errno = state->output_error;
+      return FALSE;
+    }
+    if (events & WAIT_RESIZED)
+      sp->_sig_winch = TRUE;
+  }
+  return sp->_sig_winch;
+}
+
+int
+_nc_pyxis_wait(SCREEN *sp, int milliseconds, int *left)
+{
+  struct native_terminal *state = native_state(TCBOf(sp));
+  uint64_t now, end;
+  if (state == NULL || _nc_pyxis_output_status(sp) == ERR || native_now(&now) == ERR)
