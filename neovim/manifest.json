{
  "format": 1,
  "id": "org.pyxis.neovim",
  "entry": "bin/nvim.pxe",
  "commands": {"nvim": "bin/nvim.pxe"},
  "resource_dirs": {"nvim_runtime": "share/nvim/runtime"},
  "sdk": "optional",
  "grants": [
    {"name": "memory", "resource": "memory", "rights": ["manage"], "required": true},
    {"name": "clock", "resource": "clock", "rights": ["read", "precise", "sleep"], "required": true},
    {"name": "launcher", "resource": "launcher", "rights": ["launch"], "required": true},
    {"name": "pipe", "resource": "pipe", "rights": ["create"], "required": true},
    {"name": "threads", "resource": "threads", "rights": ["manage"], "required": false},
    {"name": "random", "resource": "random", "rights": ["read"], "required": false},
    {"name": "system_info", "resource": "system_info", "rights": ["read"], "required": false},
    {"name": "fat32_data", "resource": "directory", "source": "fat32_write", "root": "edit",
     "rights": ["lookup", "enumerate", "read-files", "create", "write-files", "remove"], "required": false}
  ]
}
