+-- Pyxis paths are ROOT://rest, and each process names its own roots. A file URI
+-- carries the root name as its first path segment: home://test/a.c is
+-- file:///home/test/a.c. A Pyxis path is never sent as a URI itself, since
+-- home://test/... would parse "test" as a host.
+local PYXIS_PATH_PATTERN = '^([%w._+-]+)://(.*)$'
+
+local pyxis ---@type boolean?
+
+-- Checked once, so later conversions also work in fast callbacks.
+---@return boolean
+local function is_pyxis()
+  if pyxis == nil then
+    pyxis = vim.fn.has('pyxis') == 1
+  end
+  return pyxis
+end
+
+---@param path string
+---@return string URI
+local function pyxis_uri_from_fname(path)
+  local root, rest = path:match(PYXIS_PATH_PATTERN)
+  if not root and path:sub(1, 1) ~= '/' then
+    -- A relative name is resolved against the editor's working directory.
+    path = vim.fn.fnamemodify(path, ':p')
+    root, rest = path:match(PYXIS_PATH_PATTERN)
+  end
+  if not root then
+    error('Pyxis path has no root: ' .. path)
+  end
+  return 'file:///' .. M.uri_encode(root) .. '/' .. M.uri_encode(rest)
+end
+
+---@param uri string file URI without a fragment
+---@return string filename
+local function pyxis_uri_to_fname(uri)
+  local authority, path = uri:match('^file://([^/]*)(/.*)$')
+  if authority ~= '' then
+    error('Pyxis file URI must have an empty authority and an absolute path: ' .. uri)
+  end
+  local root, rest = path:match('^/([^/]+)/?(.*)$')
+  if not root then
+    error('Pyxis file URI has no root segment: ' .. uri)
+  end
+  return M.uri_decode(root) .. '://' .. M.uri_decode(rest)
+end
+
