+#ifdef __pyxis__
+// File selection must anchor a possibly absent leaf to a proved existing parent.
+char *path_native_file_name(const char *fname)
+{
+  if (fname == NULL) {
+    return NULL;
+  }
+  if (strlen(fname) >= MAXPATHL) {
+    emsg(_("E212: Native file name too long"));
+    return NULL;
+  }
+  char *full = xmalloc(MAXPATHL);
+  if (path_to_absolute(fname, full, MAXPATHL, true) == FAIL) {
+    xfree(full);
+    emsg(_("E212: Cannot prove native file parent"));
+    return NULL;
+  }
+  return full;
+}
+#endif
