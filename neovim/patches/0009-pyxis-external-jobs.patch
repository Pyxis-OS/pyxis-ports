+#ifdef __pyxis__
+/// Requests native termination once; completion still arrives through the exit
+/// callback.
+static void proc_terminate(Proc *proc)
+{
+  if (proc->terminated) {
+    return;
+  }
+  proc->terminated = true;
+  int error = uv_pyxis_process_terminate(&((LibuvProc *)proc)->uv);
+  if (error) {
+    ELOG("Native child termination failed: %s", uv_strerror(error));
+    abort();
+  }
+}
+#endif
