+#ifdef __pyxis__
+/// Opens `name` as the shell would run it, a bare name through bin://, the
+/// catalog, boot:// and home://bin, then releases what it opened.
+static bool program_exists(const char *name)
+{
+  const struct path_context *context;
+  if (pyxis_working_context(&context) != CALL_OK) {
+    return false;
+  }
+  size_t length = strlen(name);
+  if (length > SIZE_MAX - PROGRAM_LOOKUP_EXTRA
+      || context->count > SIZE_MAX / sizeof(handle_t) - length - PROGRAM_LOOKUP_EXTRA) {
+    return false;
+  }
+  size_t capacity = length + PROGRAM_LOOKUP_EXTRA;
+  struct path_workspace workspace = {
+    .directories = xmalloc((context->count + capacity) * sizeof(handle_t)),
+    .directory_capacity = context->count + capacity,
+    .component = xmalloc(capacity),
+    .component_capacity = capacity,
+  };
+  handle_t image;
+  struct bundle_program *bundle;
+  enum call_status status = program_open(context, name, &workspace, &image, &bundle);
+  if (status == CALL_OK) {
+    if (bundle != NULL) {
+      bundle_program_close(bundle);
+    } else {
+      handle_close(image);
+    }
+  }
+  xfree(workspace.component);
+  xfree(workspace.directories);
+  return status == CALL_OK;
+}
+#endif
