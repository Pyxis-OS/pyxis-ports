+#ifdef __pyxis__
+/// The internal --embed server is the one child that receives the loop's pipe
+/// factory; it also answers uname and the hostname from SYSTEM_INFO READ.
+static int spawn_internal_server(Proc *proc, LibuvProc *uvproc)
+{
+  handle_t pipe_service = HANDLE_INVALID;
+  environment_capability(startup_environment_handle(), "pipe", &pipe_service);
+  uv_pyxis_resource_t resources[2] = {
+    { .name = "pipe", .source = pipe_service,
+      .rights = PIPE_SERVICE_RIGHT_CREATE, .transport = 0 },
+  };
+  size_t resource_count = 1;
+  handle_t system_info = HANDLE_INVALID;
+  environment_capability(startup_environment_handle(), "system_info", &system_info);
+  if (system_info != HANDLE_INVALID) {
+    resources[resource_count++] = (uv_pyxis_resource_t){
+      .name = "system_info", .source = system_info,
+      .rights = SYSTEM_INFO_RIGHT_READ, .transport = 0 };
+  }
+  int status = uv_pyxis_spawn(&proc->loop->uv, &uvproc->uv, &uvproc->uvopts,
+                              resources, resource_count);
+  if (pipe_service != HANDLE_INVALID) {
+    handle_close(pipe_service);
+  }
+  if (system_info != HANDLE_INVALID) {
+    handle_close(system_info);
+  }
+  return status;
+}
+#endif
