diff --git a/src/nvim/path.c b/src/nvim/path.c
--- a/src/nvim/path.c
+++ b/src/nvim/path.c
@@ -1931,6 +1931,16 @@ char *fix_fname(const char *fname)
 }
 
 #ifdef __pyxis__
+// A root is held when its own directory opens, such as home:// for home://a.
+static bool path_native_root_held(const char *fname)
+{
+  char root[MAXPATHL];
+  size_t len = (size_t)(strchr(fname, ':') + 3 - fname);
+  memcpy(root, fname, len);
+  root[len] = NUL;
+  return os_isdir(root);
+}
+
 // File selection must anchor a possibly absent leaf to a proved existing parent.
 char *path_native_file_name(const char *fname)
 {
@@ -1944,6 +1954,11 @@ char *path_native_file_name(const char *fname)
   char *full = xmalloc(MAXPATHL);
   if (path_to_absolute(fname, full, MAXPATHL, true) == FAIL) {
     xfree(full);
+    // As with URLs elsewhere, a root this process does not hold names no
+    // native file; Lua may still show the buffer, e.g. a language server root.
+    if (path_is_absolute(fname) && !path_native_root_held(fname)) {
+      return xstrdup(fname);
+    }
     emsg(_("E212: Cannot prove native file parent"));
     return NULL;
   }
