diff --git a/runtime/lua/vim/fs.lua b/runtime/lua/vim/fs.lua
--- a/runtime/lua/vim/fs.lua
+++ b/runtime/lua/vim/fs.lua
@@ -47,6 +47,9 @@ local M = {}
 -- Lua's compiled path separator also works without a uname operation or editor API.
 local iswin = package.config:sub(1, 1) == '\\'
 local os_sep = iswin and '\\' or '/'
+local ispyxis = vim.fn.has('pyxis') == 1
+-- A Pyxis path is ROOT://rest, and its root is the top of the path.
+local PYXIS_ROOT_PATTERN = '^[%w._+-]+://'
 
 --- Iterate over all the parents of the given path (not expanded/resolved, the caller must do that).
 ---
@@ -101,6 +104,12 @@ function M.dirname(file)
       return file
     end
   end
+  local root = ispyxis and file:match(PYXIS_ROOT_PATTERN)
+  if root then
+    local rest = file:sub(#root + 1):gsub('/+$', '')
+    local parent = rest:match('^(.*)/')
+    return parent and root .. parent or root
+  end
   if not file:match('/') then
     return '.'
   elseif file == '/' or file:match('^/[^/]+$') then
@@ -159,8 +168,9 @@ function M.joinpath(...)
 
   local path = table.concat(segments, '/')
 
-  if vim.fn.has('pyxis') == 1 then
-    return path
+  if ispyxis then
+    -- Joining onto a bare root, such as host://, adds no separator of its own.
+    return (path:gsub('^([%w._+-]+://)/+', '%1'))
   end
   return (path:gsub(iswin and '[/\\][/\\]*' or '//+', '/'))
 end
@@ -825,6 +835,10 @@ function M.abspath(path)
   -- Expand ~ to user's home directory
   path = expand_home(path)
 
+  if ispyxis and path:match(PYXIS_ROOT_PATTERN) then
+    return path
+  end
+
   -- Convert path separator to `/`
   path = path:gsub(os_sep, '/')
 
