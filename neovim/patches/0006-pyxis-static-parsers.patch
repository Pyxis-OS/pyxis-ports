   }
@@ -242,6 +270,35 @@ static int add_language(lua_State *L, bool is_wasm)
   return 1;
 }
 
+#ifdef __pyxis__
+static int tslua_add_language_from_static(lua_State *L)
+{
+  const char *lang_name = luaL_checkstring(L, 1);
+  const char *symbol = luaL_optstring(L, 2, lang_name);
+  if (map_has(cstr_t, &langs, lang_name)) {
+    lua_pushboolean(L, true);
+    return 1;
+  }
+  for (size_t i = 0; i < ARRAY_SIZE(builtin_languages); i++) {
+    if (strcmp(symbol, builtin_languages[i].name) == 0) {
+      return register_language(L, lang_name, builtin_languages[i].language());
+    }
+  }
+  lua_pushnil(L);
+  return 1;
+}
+
+static int tslua_get_builtin_languages(lua_State *L)
+{
+  lua_createtable(L, ARRAY_SIZE(builtin_languages), 0);
+  for (size_t i = 0; i < ARRAY_SIZE(builtin_languages); i++) {
+    lua_pushstring(L, builtin_languages[i].name);
+    lua_rawseti(L, -2, (int)i + 1);
+  }
+  return 1;
+}
+#endif
