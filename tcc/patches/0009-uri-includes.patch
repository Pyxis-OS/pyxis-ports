+/* http(s) names are fetched snapshots: they resolve relative includes by
+   RFC 3986 and have no file identity. Every other scheme is a native root. */
+ST_FUNC int tcc_network_uri(const char *path)
+{
+    return !strncasecmp(path, "http://", 7) || !strncasecmp(path, "https://", 8);
+}
+
+/* RFC 3986 section 5.2.4 on a path that starts with '/', in place. */
+static void uri_remove_dot_segments(char *path)
+{
+    char *out = path;
+    const char *in = path;
+
+    while (*in) {
+        const char *segment = in + 1, *end = segment;
+        size_t length;
+
+        while (*end && *end != '/')
+            ++end;
+        length = end - segment;
+        if (length == 1 && segment[0] == '.') {
+            if (!*end)
+                *out++ = '/';
+        } else if (length == 2 && segment[0] == '.' && segment[1] == '.') {
+            while (out > path && *--out != '/')
+                ;
+            if (!*end)
+                *out++ = '/';
+        } else {
+            memmove(out, in, length + 1);
+            out += length + 1;
+        }
+        in = end;
+    }
+    if (out == path)
+        *out++ = '/';
+    *out = '\0';
+}
+
+/* Lower-case scheme and host, drop the default port, remove dot segments,
+   give an empty path "/" and drop the fragment; the query is kept. */
+ST_FUNC char *tcc_uri_normalize(const char *uri)
+{
+    const char *authority = strstr(uri, "://") + 3;
+    size_t authority_length = strcspn(authority, "/?#");
+    const char *path = authority + authority_length;
+    size_t path_length = strcspn(path, "?#");
+    size_t query_length = path[path_length] == '?' ? strcspn(path + path_length, "#") : 0;
+    size_t scheme_length = authority - uri;
+    char *result = tcc_malloc(scheme_length + authority_length + path_length + query_length + 2);
+    char *p = result;
+    size_t i;
+
+    for (i = 0; i < scheme_length + authority_length; ++i)
+        *p++ = uri[i] >= 'A' && uri[i] <= 'Z' ? uri[i] - 'A' + 'a' : uri[i];
+    *p = '\0';
+    if (p - result > 3 && !strcmp(p - 3, ":80") && !strncmp(result, "http:", 5))
+        p -= 3;
+    else if (p - result > 4 && !strcmp(p - 4, ":443") && !strncmp(result, "https:", 6))
+        p -= 4;
+    if (path_length) {
+        memcpy(p, path, path_length);
+        p[path_length] = '\0';
+        uri_remove_dot_segments(p);
+        p += strlen(p);
+    } else {
+        *p++ = '/';
+    }
+    memcpy(p, path + path_length, query_length);
+    p[query_length] = '\0';
+    return result;
+}
