+/* Resolve a path-relative include name against a normalized http(s) base by
+   RFC 3986 section 5.2: merge with the base path, remove dot segments. */
+static void uri_resolve(const char *base, const char *ref, char *out, size_t size)
+{
+    const char *authority = strstr(base, "://") + 3;
+    const char *path = authority + strcspn(authority, "/?#");
+    const char *last = path;
+    size_t prefix, ref_path = strcspn(ref, "?#");
+    char *merged;
+
+    if (!ref_path)
+        tcc_error("include name '%s' has no path", ref);
+    for (const char *p = path; *p && *p != '?' && *p != '#'; ++p)
+        if (*p == '/')
+            last = p + 1;
+    prefix = last - base;
+    if (prefix + strlen(ref) + 1 >= size)
+        tcc_error("include path is too long");
+    memcpy(out, base, prefix);
+    if (last == path)
+        out[prefix++] = '/'; /* an empty base path merges as "/" */
+    strcpy(out + prefix, ref);
+    merged = tcc_uri_normalize(out);
+    pstrcpy(out, size, merged);
+    tcc_free(merged);
+}
+
+/* A once-marked http(s) header named again is skipped before fetching. */
+static int once_uri_seen(TCCState *s1, const char *uri)
+{
+    OnceInclude *once;
+    char *normal = tcc_uri_normalize(uri);
+
+    for (once = s1->once_includes; once; once = once->next)
+        if ((once->requested && !strcmp(once->requested, normal))
+            || (once->url && !strcmp(once->url, normal)))
+            break;
+    tcc_free(normal);
+    return once != NULL;
+}
