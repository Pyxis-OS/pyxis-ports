+#ifdef __pyxis__
+/* Open without reporting: 0, or the errno of the failure. A fetched http(s)
+   snapshot records its final URL for relative includes and #pragma once. */
+ST_FUNC int tcc_open_error(TCCState *s1, const char *filename)
+{
+    struct pyxis_response_info response;
+
+    if (strlen(filename) >= sizeof(file->filename))
+        return ENAMETOOLONG;
+    /* Link the buffer before opening: compile-error unwinding owns it. */
+    tcc_open_bf(s1, filename, 0);
+    file->stream = open_input(s1, filename);
+    if (!file->stream) {
+        int error = errno;
+        tcc_close();
+        return error;
+    }
+    if (file->stream != stdin && !pyxis_stdio_response(file->stream, &response)
+        && (response.flags & PYXIS_RESPONSE_URL) && tcc_network_uri(response.url))
+        file->url = tcc_uri_normalize(response.url);
+    return 0;
+}
+
+ST_FUNC int tcc_open(TCCState *s1, const char *filename)
+{
+    int error = tcc_open_error(s1, filename);
+
+    if (error == ENAMETOOLONG)
+        return tcc_error_noabort("input filename is too long");
+    if (error && error != ENOENT)
+        tcc_error_noabort("could not open '%s': %s", filename, strerror(error));
+    return error ? -1 : 0;
+}
