@@ -793,7 +793,11 @@ ST_FUNC void tcc_close(void)
     TCCState *s1 = tcc_state;
     BufferedFile *bf = file;
     if (bf->stream && bf->stream != stdin) {
+#ifdef __pyxis__
+        if (!bf->once_owned && fclose(bf->stream))
