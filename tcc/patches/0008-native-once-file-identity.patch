diff --git a/tccpp.c b/tccpp.c
index ab3a716..73ae62e 100644
--- a/tccpp.c
+++ b/tccpp.c
@@ -1327,6 +1327,48 @@ ST_FUNC void skip_to_eol(int warn)
 static CachedInclude *
 search_cached_include(TCCState *s1, const char *filename, int add);
 
+#ifdef __pyxis__
+static void once_identity(BufferedFile *bf, struct stat *identity)
+{
+    if (!bf->stream || fstat(fileno(bf->stream), identity))
+        tcc_error("could not query file identity for '%s'", bf->true_filename);
+    if ((identity->st_valid & (STAT_DEV_VALID | STAT_INO_VALID))
+        != (STAT_DEV_VALID | STAT_INO_VALID))
+        tcc_error("#pragma once comparison requires file identity for '%s'",
+                  bf->true_filename);
+}
+
+static int once_include_seen(TCCState *s1, BufferedFile *bf)
+{
+    OnceInclude *once;
+    struct stat identity;
+
+    once_identity(bf, &identity);
+    for (once = s1->once_includes; once; once = once->next)
+        if (once->domain == identity.st_dev && once->object == identity.st_ino)
+            return 1;
+    return 0;
+}
+
+static void once_include_add(TCCState *s1, BufferedFile *bf)
+{
+    OnceInclude *once;
+    struct stat identity;
+
+    if (bf->once_owned)
+        return;
+    once_identity(bf, &identity);
+    once = tcc_malloc(sizeof(*once) + strlen(bf->true_filename));
+    strcpy(once->filename, bf->true_filename);
+    once->stream = bf->stream;
+    once->domain = identity.st_dev;
+    once->object = identity.st_ino;
+    once->next = s1->once_includes;
+    s1->once_includes = once;
+    bf->once_owned = 1;
+}
+#endif
+
 static int parse_include(TCCState *s1, int do_next, int test)
 {
     int c, i;
@@ -1414,7 +1456,11 @@ static int parse_include(TCCState *s1, int do_next, int test)
             tcc_error("include path is too long");
         pstrcat(buf, sizeof buf, name);
         e = search_cached_include(s1, buf, 0);
-        if (e && (define_find(e->ifndef_macro) || e->once)) {
+        if (e && (define_find(e->ifndef_macro)
+#ifndef __pyxis__
+                  || e->once
+#endif
+                  )) {
             /* no need to parse the include because the 'ifndef macro'
                is defined (or had #pragma once) */
 #ifdef INC_DEBUG
@@ -1436,6 +1482,13 @@ static int parse_include(TCCState *s1, int do_next, int test)
 #endif
     }
 
+#ifdef __pyxis__
+    if (!test && s1->once_includes && once_include_seen(s1, file)) {
+        tcc_close();
+        return 1;
+    }
+#endif
+
     if (test) {
         tcc_close();
     } else {
@@ -1717,7 +1770,11 @@ static int pragma_parse(TCCState *s1)
         pp_debug_tok = t, pp_debug_symv = v;
 
     } else if (tok == TOK_once) {
+#ifdef __pyxis__
+        once_include_add(s1, file);
+#else
         search_cached_include(s1, file->true_filename, 1)->once = 1;
+#endif
 
     } else if (s1->output_type == TCC_OUTPUT_PREPROCESS) {
         /* tcc -E: keep pragmas below unchanged */
@@ -3796,6 +3853,15 @@ ST_FUNC void tccpp_delete(TCCState *s)
 {
     int i, n;
 
+#ifdef __pyxis__
+    while (s->once_includes) {
+        OnceInclude *once = s->once_includes;
+        s->once_includes = once->next;
+        if (once->stream != stdin && fclose(once->stream))
+            tcc_error_noabort("could not close once header '%s'", once->filename);
+        tcc_free(once);
