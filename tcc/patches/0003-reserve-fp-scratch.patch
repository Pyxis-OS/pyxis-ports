 /* load 'r' from value 'sv' */
+/* FP register transfers need a memory operand. Pyxis does not use a red zone;
+   LEA preserves any pending integer comparison while reserving the scratch. */
+static void fp_scratch_begin(void)
+{
+#ifdef TCC_TARGET_PYXIS
+    o(0x24648d48); g(-16); /* lea -16(%rsp),%rsp */
+#endif
+}
+
+static void fp_scratch_address(void)
+{
+    g(0x24); /* SIB: base RSP, no index */
+#ifdef TCC_TARGET_PYXIS
+    g(0);
+#else
+    g(-16);
+#endif
+}
+
+static void fp_scratch_end(void)
+{
+#ifdef TCC_TARGET_PYXIS
+    o(0x24648d48); g(16); /* lea 16(%rsp),%rsp */
+#endif
+}
+
