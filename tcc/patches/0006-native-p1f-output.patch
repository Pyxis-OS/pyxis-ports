diff --git a/tccp1f.c b/tccp1f.c
new file mode 100644
index 0000000..0689e16
--- /dev/null
+++ b/tccp1f.c
@@ -0,0 +1,171 @@
+/* Pyxis P1F output. Layout and relocations remain in the ELF linker. */
+
+static int p1f_check_sections(TCCState *s1)
+{
+    Section *s;
+    ElfW(Sym) *sym;
+    ElfW_Rel *rel;
+    int i, type;
+
+    for_each_elem(symtab_section, 1, sym, ElfW(Sym)) {
+        type = ELFW(ST_TYPE)(sym->st_info);
+        if (type == STT_TLS || type == STT_GNU_IFUNC)
+            return tcc_error_noabort("P1F does not support TLS or indirect functions");
+    }
+    for (i = 1; i < s1->nb_sections; ++i) {
+        s = s1->sections[i];
+        if (s->sh_flags & SHF_TLS)
+            return tcc_error_noabort("P1F does not support TLS: %s", s->name);
+        if ((s->sh_flags & (SHF_WRITE | SHF_EXECINSTR)) == (SHF_WRITE | SHF_EXECINSTR))
+            return tcc_error_noabort("P1F does not support writable executable sections: %s", s->name);
+        if ((s->sh_flags & SHF_ALLOC) && s->data_offset
+            && s->sh_type != SHT_PROGBITS && s->sh_type != SHT_NOBITS
+            && s->sh_type != SHT_NOTE)
+            return tcc_error_noabort("unsupported P1F section: %s", s->name);
+        if (s->sh_type != SHT_RELX)
+            continue;
+        for_each_elem(s, 0, rel, ElfW_Rel) {
+            switch (ELFW(R_TYPE)(rel->r_info)) {
+            case R_X86_64_NONE:
+            case R_X86_64_32: case R_X86_64_32S: case R_X86_64_64:
+            case R_X86_64_PC32: case R_X86_64_PC64:
+            case R_X86_64_PLT32: case R_X86_64_PLTOFF64:
+            case R_X86_64_GOT32: case R_X86_64_GOT64:
+            case R_X86_64_GOTPC32: case R_X86_64_GOTPC64:
+            case R_X86_64_GOTOFF64: case R_X86_64_GOTPCREL:
+            case R_X86_64_GOTPCRELX: case R_X86_64_REX_GOTPCRELX:
+                break;
+            default:
+                return tcc_error_noabort("unsupported P1F relocation %d in %s",
+                    (int)ELFW(R_TYPE)(rel->r_info), s->name);
+            }
+        }
+    }
+    return 0;
+}
+
+static int p1f_check_layout_size(TCCState *s1)
+{
+    uint64_t budget = 0, align;
+    Section *s;
+    int i;
+
+    /* Upstream layout uses signed int file offsets. Bound every section and
+       worst-case alignment gap before that arithmetic, including debug data. */
+    if (s1->nb_sections > INT_MAX / (2 * sizeof(int)))
+        return tcc_error_noabort("too many P1F sections");
+    for (i = 1; i < s1->nb_sections; ++i) {
+        s = s1->sections[i];
+        align = s->sh_addralign;
+        if (!align || (align & (align - 1)))
+            return tcc_error_noabort("invalid section alignment: %s", s->name);
+        if (align < P1F_PAGE_SIZE)
+            align = P1F_PAGE_SIZE;
+        if (align > INT_MAX || s->sh_size > INT_MAX
+            || budget > INT_MAX - align
+            || s->sh_size > INT_MAX - budget - align)
+            return tcc_error_noabort("P1F image exceeds linker layout limits");
+        budget += align + s->sh_size;
+    }
+    return 0;
+}
+
+static int p1f_write_zeros(FILE *f, uint64_t count)
+{
+    static const unsigned char zeros[256];
+    size_t size;
+
+    while (count) {
+        size = count > sizeof zeros ? sizeof zeros : count;
+        if (fwrite(zeros, 1, size, f) != size)
+            return -1;
+        count -= size;
+    }
+    return 0;
+}
+
+static int tcc_output_p1f(TCCState *s1, FILE *f, int phnum, ElfW(Phdr) *phdr)
+{
+    struct p1f_header header = { P1F_MAGIC, 0, 0 };
+    struct p1f_segment *segments, *segment;
+    ElfW(Phdr) *ph;
+    Section *s;
+    uint64_t previous_end = 0, end, offset, written;
+    int i, j, entry_found = 0, ret = -1;
+
+    header.entry = get_sym_addr(s1, "_start", 1, 0);
+    if (s1->nb_errors)
+        return -1;
+    segments = tcc_mallocz(phnum * sizeof(*segments));
+    for (i = 0; i < phnum; ++i) {
+        ph = &phdr[i];
+        if (ph->p_type != PT_LOAD || !ph->p_memsz)
+            continue;
+        if (ph->p_vaddr < P1F_PAGE_SIZE || ph->p_vaddr % P1F_PAGE_SIZE
+            || ph->p_vaddr < previous_end || ph->p_vaddr >= P1F_USER_LIMIT
+            || ph->p_memsz > P1F_USER_LIMIT - ph->p_vaddr
+            || !(ph->p_flags & PF_R) || (ph->p_flags & ~(PF_R | PF_W | PF_X))
+            || (ph->p_flags & (PF_W | PF_X)) == (PF_W | PF_X))
+            goto invalid;
+        end = ph->p_vaddr + ph->p_memsz;
+        previous_end = (end + P1F_PAGE_SIZE - 1) & ~(P1F_PAGE_SIZE - 1);
+        segment = &segments[header.segment_count++];
+        segment->virtual_address = ph->p_vaddr;
+        segment->memory_size = ph->p_memsz;
+        segment->flags = P1F_READ;
+        if (ph->p_flags & PF_W)
+            segment->flags |= P1F_WRITE;
+        if (ph->p_flags & PF_X) {
+            segment->flags |= P1F_EXECUTE;
+            if (header.entry >= ph->p_vaddr && header.entry < end)
+                entry_found = 1;
+        }
+        /* File bytes extend through the last backed section. Interior gaps
+           are emitted as zeros; a trailing NOBITS extent stays out of the file. */
+        for (j = 1; j < s1->nb_sections; ++j) {
+            s = s1->sections[j];
+            if (!(s->sh_flags & SHF_ALLOC) || !s->sh_size
+                || s->sh_addr < ph->p_vaddr || s->sh_addr >= end)
+                continue;
+            if (s->sh_size > end - s->sh_addr)
+                goto invalid;
+            if (s->sh_type != SHT_NOBITS)
+                segment->file_size = s->sh_addr + s->sh_size - ph->p_vaddr;
+        }
+    }
+    if (!entry_found)
+        goto invalid;
+    if (fwrite(&header, sizeof header, 1, f) != 1
+        || fwrite(segments, sizeof(*segments), header.segment_count, f) != header.segment_count)
+        goto write_error;
+    for (i = 0; i < header.segment_count; ++i) {
+        segment = &segments[i];
+        written = 0;
+        for (j = 1; j < s1->nb_sections; ++j) {
+            s = s1->sections[j];
+            if (!(s->sh_flags & SHF_ALLOC) || s->sh_type == SHT_NOBITS || !s->sh_size
+                || s->sh_addr < segment->virtual_address)
+                continue;
+            offset = s->sh_addr - segment->virtual_address;
+            if (offset >= segment->memory_size)
+                continue;
+            if (offset < written || offset > segment->file_size
+                || s->sh_size > segment->file_size - offset)
+                goto invalid;
+            if (p1f_write_zeros(f, offset - written)
+                || fwrite(s->data, 1, s->sh_size, f) != s->sh_size)
+                goto write_error;
+            written = offset + s->sh_size;
+        }
+    }
+    ret = 0;
+    goto done;
+ invalid:
+    tcc_error_noabort("invalid P1F segment layout or entry point");
+    goto done;
+ write_error:
+    tcc_error_noabort("could not write P1F image");
+ done:
+    tcc_free(segments);
+    return ret;
+}
