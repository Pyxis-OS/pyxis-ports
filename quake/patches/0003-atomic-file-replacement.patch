+//
+// replace a file as a whole: the data goes to a temporary file in the same
+// directory, which is synced and renamed over the target on close, so a failed
+// or interrupted write leaves the old file intact
+//
+// Sys_AtomicOpen returns NULL on failure; Sys_AtomicClose returns false if the
+// file could not be replaced. Both report the reason on the console.
+FILE *Sys_AtomicOpen (char *path);
+qboolean Sys_AtomicClose (FILE *file);
+
 //
 // memory protection
 //
