+#define	MAX_ENGINE_STRINGS	512
+static char	*pr_engine_strings[MAX_ENGINE_STRINGS];
+static int	pr_num_engine_strings;
+
+char *PR_GetString (string_t num)
+{
+	if (num >= 0)
+		return pr_strings + num;
+	if (-num > pr_num_engine_strings)
+		Sys_Error ("PR_GetString: invalid string %i", num);
+	return pr_engine_strings[-num - 1];
+}
+
+// Table entries are engine-owned storage that outlives every edict referring
+// to it, such as static buffers and model names. The same pointer reuses its index.
+string_t PR_SetEngineString (char *s)
+{
+	uintptr_t	offset = (uintptr_t)s - (uintptr_t)pr_strings;
+	int		i;
+
+	if ((uintptr_t)s >= (uintptr_t)pr_strings && offset <= INT_MAX)
+		return (string_t)offset;
+	for (i = 0 ; i < pr_num_engine_strings ; i++)
+		if (pr_engine_strings[i] == s)
+			return -i - 1;
+	if (pr_num_engine_strings == MAX_ENGINE_STRINGS)
+		Sys_Error ("PR_SetEngineString: too many engine strings");
+	pr_engine_strings[pr_num_engine_strings++] = s;
+	return -pr_num_engine_strings;
+}
+
