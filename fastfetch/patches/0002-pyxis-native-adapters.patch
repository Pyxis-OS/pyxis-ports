+/* SPDX-License-Identifier: MPL-2.0 */
+#include "terminalsize.h"
+
+#include <console.h>
+#include <startup.h>
+
+bool ffDetectTerminalSize(FFTerminalSizeResult *result, [[maybe_unused]] bool fast_only)
+{
+  handle_t output = startup_resource("output");
+  if (output == HANDLE_INVALID) {
+    return false;
+  }
+  size_t columns, rows;
+  if (console_size(output, &columns, &rows) != CALL_OK ||
+      columns == 0 || rows == 0 || columns > UINT16_MAX || rows > UINT16_MAX) {
+    return false;
+  }
+  *result = (FFTerminalSizeResult) {
+    .columns = (uint16_t) columns,
+    .rows = (uint16_t) rows,
+  };
+  return true;
+}
