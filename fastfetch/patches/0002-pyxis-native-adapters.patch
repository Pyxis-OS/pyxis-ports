new file mode 100644
index 0000000..d15b6df
--- /dev/null
+++ b/src/common/impl/FFPlatform_pyxis.c
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "FFPlatform_private.h"
+#include "common/pyxis.h"
+
+#include <abi/memory.h>
+#include <startup.h>
+#include <system_info.h>
+
+static struct system_info_identity identity;
+static const char *identity_error;
+
+const char *ffPyxisIdentityError(void)
+{
+  return identity_error;
+}
+
+const char *ffPyxisOSName(void)
+{
+  return identity.os_name;
+}
+
+void ffPlatformInitImpl(FFPlatform *platform)
+{
+  platform->sysinfo.pageSizeShift = (uint32_t) __builtin_ctzll(MEMORY_PAGE_SIZE);
+
+  identity = (struct system_info_identity) {};
+  handle_t handle = startup_resource("system_info");
+  if (handle == HANDLE_INVALID) {
+    identity_error = "Missing system_info READ grant";
+    return;
+  }
+  if (system_info_get_identity(handle, &identity) != CALL_OK) {
+    identity_error = "Native system identity query failed";
+    return;
+  }
+  identity_error = nullptr;
+  ffStrbufSetS(&platform->sysinfo.name, identity.kernel_name);
+  ffStrbufSetS(&platform->sysinfo.release, identity.build_revision);
+  ffStrbufSetS(&platform->sysinfo.architecture, identity.architecture);
+}
