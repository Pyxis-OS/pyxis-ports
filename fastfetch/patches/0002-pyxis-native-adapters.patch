+#include <system_info.h>
+
+const char *ffDetectMemory(FFMemoryResult *memory)
+{
+  handle_t handle = startup_resource("system_info");
+  if (handle == HANDLE_INVALID) {
+    return "Missing system_info READ grant";
+  }
+  struct system_info_memory info;
+  if (system_info_get_memory(handle, &info) != CALL_OK) {
