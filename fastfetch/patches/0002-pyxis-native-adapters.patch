diff --git a/src/detection/terminalsize/terminalsize_pyxis.c b/src/detection/terminalsize/terminalsize_pyxis.c
new file mode 100644
index 0000000..1978df8
--- /dev/null
+++ b/src/detection/terminalsize/terminalsize_pyxis.c
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "terminalsize.h"
+
+#include <console.h>
+#include <startup.h>
+#include <environment.h>
+#include <handle.h>
+
+bool ffDetectTerminalSize(FFTerminalSizeResult *result, [[maybe_unused]] bool fast_only)
+{
+  handle_t output = HANDLE_INVALID;
+  environment_capability(startup_environment_handle(), "output", &output);
+  if (output == HANDLE_INVALID) {
+    return false;
+  }
+  struct console_size_reply size;
+  enum call_status status = console_size(output, &size);
+  handle_close(output);
+  if (status != CALL_OK ||
+      size.columns > UINT16_MAX || size.rows > UINT16_MAX) {
+    return false;
+  }
+  *result = (FFTerminalSizeResult) {
+    .columns = (uint16_t) size.columns,
+    .rows = (uint16_t) size.rows,
+  };
+  return true;
+}
diff --git a/src/detection/uptime/uptime_pyxis.c b/src/detection/uptime/uptime_pyxis.c
new file mode 100644
index 0000000..8a42bb3
--- /dev/null
+++ b/src/detection/uptime/uptime_pyxis.c
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "uptime.h"
+
+#include <clock.h>
+#include <startup.h>
+#include <environment.h>
+#include <handle.h>
+
+const char *ffDetectUptime(FFUptimeResult *result)
+{
+  handle_t handle = HANDLE_INVALID;
+  environment_capability(startup_environment_handle(), "clock", &handle);
+  if (handle == HANDLE_INVALID) {
+    return "Missing clock READ grant";
+  }
+  uint64_t nanoseconds;
+  enum call_status status = clock_coarse_now(handle, &nanoseconds);
+  handle_close(handle);
+  if (status != CALL_OK) {
+    return "Native monotonic clock query failed";
+  }
+  result->uptime = nanoseconds / UINT64_C(1000000);
+  return nullptr;
+}
