diff --git a/src/common/impl/io_pyxis.c b/src/common/impl/io_pyxis.c
new file mode 100644
index 0000000..add1a24
--- /dev/null
+++ b/src/common/impl/io_pyxis.c
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "common/io.h"
+
+#include <handle.h>
+#include <path.h>
+#include <startup.h>
+#include <stdlib.h>
+
+bool ffIsTerminal(int fd)
+{
+  if (fd < STDIN_FILENO || fd > STDERR_FILENO) {
+    return false;
+  }
+  struct startup_stream stream = startup_stream((enum startup_stream_index) fd);
+  return stream.protocol == PROTOCOL_CONSOLE && stream.handle != HANDLE_INVALID;
+}
+
+bool ffAppendFDBuffer(FFNativeFD fd, FFstrbuf *buffer)
+{
+  char bytes[4096];
+  ssize_t count;
+  while ((count = read(fd, bytes, sizeof(bytes))) > 0) {
+    ffStrbufAppendNS(buffer, (uint32_t) count, bytes);
+  }
+  return count == 0;
+}
+
+bool ffAppendFileBuffer(const char *path, FFstrbuf *buffer)
+{
+  FILE *file = fopen(path, "r");
+  if (!file) {
+    return false;
+  }
+  char bytes[4096];
+  size_t count;
+  while ((count = fread(bytes, 1, sizeof(bytes), file)) > 0) {
+    ffStrbufAppendNS(buffer, (uint32_t) count, bytes);
+  }
+  bool success = !ferror(file);
+  if (fclose(file) != 0) {
+    success = false;
+  }
+  return success;
+}
+
+bool ffWriteFDBuffer(FFNativeFD fd, const FFstrbuf *buffer)
+{
+  size_t offset = 0;
+  while (offset < buffer->length) {
+    ssize_t count = write(fd, buffer->chars + offset, buffer->length - offset);
+    if (count <= 0) {
+      return false;
+    }
+    offset += (size_t) count;
+  }
+  return true;
+}
+
+bool ffPathExists(const char *path, FFPathType path_type)
+{
+  size_t length = strlen(path);
+  size_t depth = startup_working_directory_count();
+  if (length == SIZE_MAX || depth > SIZE_MAX - length - 1 ||
+      depth + length + 1 > SIZE_MAX / sizeof(handle_t)) {
+    return false;
+  }
+  size_t slots = depth + length + 1;
+  handle_t *directories = malloc(slots * sizeof(*directories));
+  char *component = malloc(length + 1);
+  if (!directories || !component) {
+    free(component);
+    free(directories);
+    return false;
+  }
+  struct path_workspace workspace = { directories, slots, component, length + 1 };
+  // Borrow the initial cwd chain; path_resolve owns only its temporary handles.
+  struct path_context context = {
+    .directories = (handle_t *) startup_working_directories(), .count = depth,
+  };
+  handle_t handle;
+  bool exists = false;
+  if (path_type & FF_PATHTYPE_FILE) {
+    exists = path_resolve(&context, path, DIRECTORY_KIND_FILE, 0, &workspace, &handle) == CALL_OK;
+  }
+  if (!exists && (path_type & FF_PATHTYPE_DIRECTORY)) {
+    exists = path_resolve(&context, path, DIRECTORY_KIND_DIRECTORY, 0, &workspace, &handle) == CALL_OK;
+  }
+  if (exists) {
+    handle_close(handle);
+  }
+  free(component);
+  free(directories);
+  return exists;
+}
