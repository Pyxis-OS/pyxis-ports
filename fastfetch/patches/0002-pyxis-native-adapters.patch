diff --git a/src/common/impl/io_pyxis.c b/src/common/impl/io_pyxis.c
new file mode 100644
index 0000000..7afc50b
--- /dev/null
+++ b/src/common/impl/io_pyxis.c
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "common/io.h"
+
+#include <handle.h>
+#include <path.h>
+#include <pyxis/working_path.h>
+#include <startup.h>
+#include <environment.h>
+#include <handle.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include <pyxis/resource.h>
+
+bool ffIsTerminal(int fd)
+{
+  return isatty(fd) == 1;
+}
+
+bool ffAppendFDBuffer(FFNativeFD fd, FFstrbuf *buffer)
+{
+  char bytes[4096];
+  ssize_t count;
+  while ((count = read(fd, bytes, sizeof(bytes))) > 0) {
+    ffStrbufAppendNS(buffer, (uint32_t) count, bytes);
+  }
+  return count == 0;
+}
+
+bool ffAppendFileBuffer(const char *path, FFstrbuf *buffer)
+{
+  FILE *file = fopen(path, "r");
+  if (!file) {
+    return false;
+  }
+  char bytes[4096];
+  size_t count;
+  while ((count = fread(bytes, 1, sizeof(bytes), file)) > 0) {
+    ffStrbufAppendNS(buffer, (uint32_t) count, bytes);
+  }
+  bool success = !ferror(file);
+  if (fclose(file) != 0) {
+    success = false;
+  }
+  return success;
+}
+
+bool ffWriteFDBuffer(FFNativeFD fd, const FFstrbuf *buffer)
+{
+  size_t offset = 0;
+  while (offset < buffer->length) {
+    ssize_t count = write(fd, buffer->chars + offset, buffer->length - offset);
+    if (count <= 0) {
+      return false;
+    }
+    offset += (size_t) count;
+  }
+  return true;
+}
+
+bool ffPathExists(const char *path, FFPathType path_type)
+{
+  size_t length = strlen(path);
+  const struct path_context *context;
+  if (pyxis_working_context(&context) != CALL_OK) {
+    return false;
+  }
+  size_t depth = context->count;
+  if (length == SIZE_MAX || depth > SIZE_MAX - length - 1 ||
+      depth + length + 1 > SIZE_MAX / sizeof(handle_t)) {
+    return false;
+  }
+  size_t slots = depth + length + 1;
+  handle_t *directories = malloc(slots * sizeof(*directories));
+  char *component = malloc(length + 1);
+  if (!directories || !component) {
+    free(component);
+    free(directories);
+    return false;
+  }
+  struct path_workspace workspace = { directories, slots, component, length + 1 };
+  handle_t handle;
+  bool exists = false;
+  if (path_type & FF_PATHTYPE_FILE) {
+    exists = path_resolve(context, path, DIRECTORY_KIND_FILE, 0, &workspace, &handle) == CALL_OK;
+  }
+  if (!exists && (path_type & FF_PATHTYPE_DIRECTORY)) {
+    exists = path_resolve(context, path, DIRECTORY_KIND_DIRECTORY, 0, &workspace, &handle) == CALL_OK;
+  }
+  if (exists) {
+    handle_close(handle);
+  }
+  free(component);
+  free(directories);
+  return exists;
+}
+
+bool ffWriteFileData(const char* fileName, size_t dataSize, const void* data)
+{
+  FILE *file = fopen(fileName, "wb");
+  if (file == NULL && errno == ENOENT) {
+    FF_STRBUF_AUTO_DESTROY path = ffStrbufCreate();
+    const char *scheme = strstr(fileName, "://");
+    const char *part = scheme ? scheme + 3 : fileName;
+    const char *slash;
+    while ((slash = strchr(part, '/')) != NULL) {
+      ffStrbufSetNS(&path, (uint32_t) (slash - fileName), fileName);
+      mkdir(path.chars, 0700);
+      part = slash + 1;
+    }
+    file = fopen(fileName, "wb");
+  }
+  if (file == NULL)
+    return false;
+  if (fwrite(data, 1, dataSize, file) != dataSize) {
+    pyxis_fclose_abandon(file);
+    return false;
+  }
+  return fclose(file) == 0;
+}
diff --git a/src/common/impl/time_pyxis.c b/src/common/impl/time_pyxis.c
new file mode 100644
index 0000000..254700c
--- /dev/null
+++ b/src/common/impl/time_pyxis.c
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "common/time.h"
+
+#include <clock.h>
+#include <time.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <startup.h>
+#include <environment.h>
+#include <handle.h>
+
+double ffTimeGetTick(void)
+{
+  uint64_t nanoseconds;
+  handle_t clock = HANDLE_INVALID;
+  enum call_status status = environment_capability(startup_environment_handle(), "clock", &clock);
+  if (status == CALL_OK) {
+    status = clock_now(clock, &nanoseconds);
+    handle_close(clock);
+  }
+  if (status != CALL_OK) {
+    fputs("Native monotonic clock query failed\n", stderr);
+    exit(1);
+  }
+  return (double) nanoseconds / 1000000.0;
+}
+
+bool ffTimeSleep(uint32_t msec)
+{
+  return nanosleep(&(struct timespec) { msec / 1000, (long) (msec % 1000) * 1000000 }, nullptr) == 0;
+}
