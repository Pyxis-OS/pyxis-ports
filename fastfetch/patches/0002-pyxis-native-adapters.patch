+/* SPDX-License-Identifier: MPL-2.0 */
+#include "common/time.h"
+
+#include <clock.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <startup.h>
+
+double ffTimeGetTick(void)
+{
+  uint64_t nanoseconds;
+  if (clock_now(startup_resource("clock"), &nanoseconds) != CALL_OK) {
+    fputs("Native monotonic clock query failed\n", stderr);
+    exit(1);
+  }
+  return (double) nanoseconds / 1000000.0;
+}
