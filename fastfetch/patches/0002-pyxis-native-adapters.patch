diff --git a/src/detection/disk/disk_pyxis.c b/src/detection/disk/disk_pyxis.c
new file mode 100644
index 0000000..2a82790
--- /dev/null
+++ b/src/detection/disk/disk_pyxis.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "disk.h"
+
+#include <directory.h>
+#include <handle.h>
+#include <startup.h>
+#include <environment.h>
+
+static void format_id(const uint8_t id[16], char text[33])
+{
+  static const char digits[] = "0123456789abcdef";
+  for (uint32_t i = 0; i < 16; ++i) {
+    text[i * 2] = digits[id[i] >> 4];
+    text[i * 2 + 1] = digits[id[i] & 15];
+  }
+  text[32] = '\0';
+}
+
+static const char *clear_disks(FFlist *disks, const char *error)
+{
+  FF_LIST_FOR_EACH (FFDisk, disk, *disks) {
+    ffStrbufDestroy(&disk->mountFrom);
+    ffStrbufDestroy(&disk->mountpoint);
+    ffStrbufDestroy(&disk->filesystem);
+    ffStrbufDestroy(&disk->name);
+  }
+  disks->length = 0;
+  return error;
+}
+
+const char *ffDetectDisksImpl(FFDiskOptions *options, FFlist *disks)
+{
+  if (options->folders.length || options->hideFolders.length) {
+    return "Folder filters are unsupported on Pyxis";
+  }
+
+  struct environment_capture capture = {};
+  if (environment_capture_init(startup_environment_handle(), 0, &capture) != CALL_OK) {
+    return "Native environment capture failed";
+  }
+  const struct environment_value *roots = capture.values;
+  const char *error = nullptr;
+  for (size_t i = 0; i < capture.count; ++i) {
+    if (roots[i].kind != ENVIRONMENT_CAP) {
+      continue;
+    }
+    struct handle_info grant;
+    if (handle_query(roots[i].handle, &grant) != CALL_OK) {
+      error = "Native root grant query failed";
+      break;
+    }
+    if (grant.kind != HANDLE_KIND_NATIVE || grant.protocol != PROTOCOL_DIRECTORY ||
+        !(grant.rights & DIRECTORY_RIGHT_FILESYSTEM_INFO)) {
+      continue;
+    }
+
+    struct directory_filesystem_info info;
+    if (directory_filesystem_info(roots[i].handle, &info) != CALL_OK) {
+      error = "Native filesystem information query failed";
+      break;
+    }
+    if (info.type != FILESYSTEM_TYPE_NPFS) {
+      error = "Unsupported native filesystem type";
+      break;
+    }
+    if (ffStrbufSeparatedContainS(&options->hideFS, "npfs", ':')) {
+      continue;
+    }
+
+    // Each snapshot grant stays owned until all queries are complete.
+    FFDisk *disk = ffListAdd(disks, sizeof(*disk));
+    *disk = (FFDisk) {};
+    ffStrbufInit(&disk->mountFrom);
+    ffStrbufInitF(&disk->mountpoint, "%s://", (const char *) roots[i].name);
+    ffStrbufInitS(&disk->filesystem, "npfs");
+    ffStrbufInitS(&disk->name, info.volume_name);
+    disk->type = FF_DISK_VOLUME_TYPE_REGULAR_BIT;
+    if (info.flags & FILESYSTEM_FLAG_READ_ONLY) {
+      disk->type |= FF_DISK_VOLUME_TYPE_READONLY_BIT;
+    }
+    format_id(info.pool_id, disk->poolId);
+    format_id(info.volume_id, disk->volumeId);
+    disk->selectedGeneration = info.generation;
+    disk->poolAllocatableBytes = info.pool_allocatable_bytes;
+    disk->gptDegraded = !!(info.flags & FILESYSTEM_FLAG_GPT_DEGRADED);
+    disk->filesystemDegraded = !!(info.flags & FILESYSTEM_FLAG_DEGRADED);
+  }
+  environment_capture_close(&capture);
+  return error ? clear_disks(disks, error) : nullptr;
+}
diff --git a/src/detection/memory/memory_pyxis.c b/src/detection/memory/memory_pyxis.c
new file mode 100644
index 0000000..b385545
--- /dev/null
+++ b/src/detection/memory/memory_pyxis.c
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "memory.h"
+
+#include <startup.h>
+#include <environment.h>
+#include <handle.h>
+#include <system_info.h>
+
+const char *ffDetectMemory(FFMemoryResult *memory)
+{
+  handle_t handle = HANDLE_INVALID;
+  environment_capability(startup_environment_handle(), "system_info", &handle);
+  if (handle == HANDLE_INVALID) {
+    return "Missing system_info READ grant";
+  }
+  struct system_info_memory info;
+  enum call_status status = system_info_get_memory(handle, &info);
+  handle_close(handle);
+  if (status != CALL_OK) {
+    return "Native allocator memory query failed";
+  }
+  memory->bytesTotal = info.total_bytes;
+  memory->bytesUsed = info.allocated_bytes;
+  return nullptr;
+}
