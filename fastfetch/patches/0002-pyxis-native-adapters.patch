new file mode 100644
index 0000000..a6b6568
--- /dev/null
+++ b/src/detection/cpu/cpu_pyxis.c
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "cpu.h"
+
+#include <startup.h>
+#include <system_info.h>
+
+const char *ffDetectCPUImpl([[maybe_unused]] const FFCPUOptions *options, FFCPUResult *cpu)
+{
+  handle_t handle = startup_resource("system_info");
+  if (handle == HANDLE_INVALID) {
+    return "Missing system_info READ grant";
+  }
+  struct system_info_cpu info;
+  if (system_info_get_cpu(handle, &info) != CALL_OK) {
+    return "Native CPU query failed";
+  }
+  if (info.online_count > UINT16_MAX) {
+    return "Online CPU count exceeds Fastfetch's representation";
+  }
+  ffStrbufSetS(&cpu->name, info.brand);
+  cpu->coresOnline = (uint16_t) info.online_count;
+  return nullptr;
+}
