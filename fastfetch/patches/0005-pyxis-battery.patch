diff --git a/src/detection/battery/battery_pyxis.c b/src/detection/battery/battery_pyxis.c
new file mode 100644
index 0000000..310a76a
--- /dev/null
+++ b/src/detection/battery/battery_pyxis.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "battery.h"
+
+#include <startup.h>
+#include <system_info.h>
+
+#define SECONDS_PER_HOUR 3600
+
+static void init_string(FFstrbuf *string, const char *value)
+{
+  ffStrbufInitS(string, value);
+  ffStrbufTrimRightSpace(string);
+}
+
+/* Discharge time as Linux computes it: remaining capacity over the present
+ * rate, both in the firmware's unit. */
+static int32_t time_remaining(const struct system_info_battery *battery)
+{
+  if (battery->remaining_capacity == SYSTEM_INFO_BATTERY_UNKNOWN ||
+      battery->present_rate == SYSTEM_INFO_BATTERY_UNKNOWN || battery->present_rate == 0) {
+    return -1;
+  }
+  uint64_t seconds = (uint64_t) battery->remaining_capacity * SECONDS_PER_HOUR / battery->present_rate;
+  return seconds > INT32_MAX ? INT32_MAX : (int32_t) seconds;
+}
+
+static const char *clear_batteries(FFlist *results, const char *error)
+{
+  FF_LIST_FOR_EACH (FFBatteryResult, result, *results) {
+    ffStrbufDestroy(&result->manufacturer);
+    ffStrbufDestroy(&result->manufactureDate);
+    ffStrbufDestroy(&result->modelName);
+    ffStrbufDestroy(&result->technology);
+    ffStrbufDestroy(&result->serial);
+  }
+  results->length = 0;
+  return error;
+}
+
+/* ACPI reports no temperature or manufacture date. Batteries without a
+ * percentage are skipped, as Linux skips those without a capacity. */
+const char *ffDetectBattery(FFBatteryOptions *options, FFlist *results)
+{
+  (void) options;
+  handle_t handle = startup_resource("system_info");
+  if (handle == HANDLE_INVALID) {
+    return "Missing system_info READ grant";
+  }
+  struct system_info_power power;
+  if (system_info_get_power(handle, &power) != CALL_OK) {
+    return "Native power query failed";
+  }
+
+  for (uint32_t i = 0; i < power.battery_count; ++i) {
+    struct system_info_battery battery;
+    if (system_info_get_battery(handle, i, &battery) != CALL_OK) {
+      return clear_batteries(results, "Native battery query failed");
+    }
+    if (!(battery.flags & SYSTEM_INFO_BATTERY_PRESENT) ||
+        battery.percent == SYSTEM_INFO_BATTERY_UNKNOWN) {
+      continue;
+    }
+
+    FFBatteryResult *result = FF_LIST_ADD(FFBatteryResult, *results);
+    init_string(&result->manufacturer, battery.oem);
+    init_string(&result->modelName, battery.model);
+    init_string(&result->technology, battery.type);
+    init_string(&result->serial, battery.serial);
+    ffStrbufInit(&result->manufactureDate);
+    result->capacity = battery.percent;
+    result->temperature = FF_BATTERY_TEMP_UNSET;
+    result->cycleCount = battery.cycle_count == SYSTEM_INFO_BATTERY_UNKNOWN ? 0 : battery.cycle_count;
+    result->timeRemaining = -1;
+    result->status = FF_BATTERY_STATUS_NONE;
+    if (power.ac == SYSTEM_INFO_AC_ONLINE) {
+      result->status |= FF_BATTERY_STATUS_AC_CONNECTED;
+    }
+    if (battery.flags & SYSTEM_INFO_BATTERY_CHARGING) {
+      result->status |= FF_BATTERY_STATUS_CHARGING;
+    }
+    if (battery.flags & SYSTEM_INFO_BATTERY_DISCHARGING) {
+      result->status |= FF_BATTERY_STATUS_DISCHARGING;
+      result->timeRemaining = time_remaining(&battery);
+    }
+    if (battery.flags & SYSTEM_INFO_BATTERY_CRITICAL) {
+      result->status |= FF_BATTERY_STATUS_CRITICAL;
+    }
+  }
+  return nullptr;
+}
