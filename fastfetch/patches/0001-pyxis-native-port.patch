+        ffStrbufInit(&os.version);
+        ffStrbufInit(&os.versionID);
+        ffStrbufInit(&os.codename);
+        ffStrbufInit(&os.buildID);
+        if (!ffPyxisIdentityError()) {
+            // The native identity snapshot owns this string until process exit.
+            ffStrbufSetStatic(&os.name, ffPyxisOSName());
+        }
+    }
+    return &os;
