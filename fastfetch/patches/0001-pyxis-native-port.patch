diff --git a/src/common/impl/init_pyxis.c b/src/common/impl/init_pyxis.c
new file mode 100644
index 0000000..258e107
--- /dev/null
+++ b/src/common/impl/init_pyxis.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "fastfetch.h"
+#include "common/init.h"
+#include "common/io.h"
+#include "common/pyxis.h"
+#include "logo/logo.h"
+
+#include <errno.h>
+#include <stdlib.h>
+
+FFinstance instance;
+bool ffPyxisFailed;
+static bool cursor_hidden;
+static bool linewrap_disabled;
+
+void ffPyxisError(const char *message)
+{
+  ffPyxisFailed = true;
+  fputs("fastfetch: ", stderr);
+  fputs(message, stderr);
+  fputc('\n', stderr);
+}
+
+[[noreturn]] void ffPyxisFatal(const char *message)
+{
+  ffFinish();
+  ffPyxisError(message);
+  exit(1);
+}
+
+/* Link wrapping also covers the bundled JSON allocator and libc formatting. */
+void *__real_malloc(size_t size);
+void *__real_calloc(size_t count, size_t size);
+void *__real_realloc(void *pointer, size_t size);
+
+void *__wrap_malloc(size_t size)
+{
+  void *result = __real_malloc(size);
+  if (!result && size) ffPyxisFatal("allocation failed");
+  return result;
+}
+
+void *__wrap_calloc(size_t count, size_t size)
+{
+  if (size && count > SIZE_MAX / size) {
+    errno = ENOMEM;
+    ffPyxisFatal("allocation size overflow");
+  }
+  void *result = __real_calloc(count, size);
+  if (!result && count && size) ffPyxisFatal("allocation failed");
+  return result;
+}
+
+void *__wrap_realloc(void *pointer, size_t size)
+{
+  void *result = __real_realloc(pointer, size);
+  if (!result && size) ffPyxisFatal("allocation failed");
+  return result;
+}
+
+void ffInitInstance(void)
+{
+  ffOptionsInitLogo(&instance.config.logo);
+  ffOptionsInitGeneral(&instance.config.general);
+  ffOptionsInitDisplay(&instance.config.display);
+  ffPlatformInit(&instance.state.platform);
+}
+
+void ffStart(void)
+{
+  if (instance.config.display.pipe) return;
+  fputs("\033[0m", stdout);
+  cursor_hidden = instance.config.display.hideCursor;
+  linewrap_disabled = instance.config.display.disableLinewrap;
+  if (cursor_hidden) fputs("\033[?25l", stdout);
+  if (linewrap_disabled) fputs("\033[?7l", stdout);
+}
+
+void ffFinish(void)
+{
+  if (cursor_hidden) fputs("\033[?25h", stdout);
+  if (linewrap_disabled) fputs("\033[?7h", stdout);
+  cursor_hidden = false;
+  linewrap_disabled = false;
+}
+
+void ffDestroyInstance(void)
+{
+  ffLogoDestroy();
+  ffPlatformDestroy(&instance.state.platform);
+  ffOptionsDestroyDisplay(&instance.config.display);
+  ffOptionsDestroyGeneral(&instance.config.general);
+  ffOptionsDestroyLogo(&instance.config.logo);
+}
+
+void ffListFeatures(void)
+{
+  puts("Pyxis native system information\nASCII logos\nJSON/JSONC (bundled yyjson)");
+}
diff --git a/src/common/impl/io_pyxis.c b/src/common/impl/io_pyxis.c
new file mode 100644
index 0000000..e38e535
--- /dev/null
+++ b/src/common/impl/io_pyxis.c
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "common/io.h"
+#include "common/pyxis.h"
+#include <startup.h>
+#include <abi/message.h>
+
+bool ffIsTerminal(int fd)
+{
+  if (fd < STDIN_FILENO || fd > STDERR_FILENO) return false;
+  struct startup_stream stream = startup_stream((enum startup_stream_index)fd);
+  return stream.protocol == PROTOCOL_CONSOLE && stream.handle != HANDLE_INVALID;
+}
+
+bool ffAppendFDBuffer(FFNativeFD fd, FFstrbuf *buffer)
+{
+  char bytes[4096];
+  ssize_t count;
+  while ((count = read(fd, bytes, sizeof(bytes))) > 0) {
+    ffStrbufAppendNS(buffer, (uint32_t)count, bytes);
+  }
+  return count == 0;
+}
+
+bool ffAppendFileBuffer(const char *path, FFstrbuf *buffer)
+{
+  FILE *file = fopen(path, "r");
+  if (!file) return false;
+  char bytes[4096];
+  size_t count;
+  while ((count = fread(bytes, 1, sizeof(bytes), file)) > 0) {
+    ffStrbufAppendNS(buffer, (uint32_t)count, bytes);
+  }
+  bool success = !ferror(file);
+  if (fclose(file) != 0) success = false;
+  return success;
+}
+
+bool ffWriteFDBuffer(FFNativeFD fd, const FFstrbuf *buffer)
+{
+  size_t offset = 0;
+  while (offset < buffer->length) {
+    ssize_t count = write(fd, buffer->chars + offset, buffer->length - offset);
+    if (count <= 0) {
+      ffPyxisError("output write failed");
+      return false;
+    }
+    offset += (size_t)count;
+  }
+  return true;
+}
