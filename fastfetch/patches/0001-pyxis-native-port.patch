diff --git a/src/common/impl/FFPlatform_pyxis.c b/src/common/impl/FFPlatform_pyxis.c
new file mode 100644
index 0000000..c59ccb3
--- /dev/null
+++ b/src/common/impl/FFPlatform_pyxis.c
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+#include "common/FFPlatform.h"
+#include "common/pyxis.h"
+
+#include <abi/memory.h>
+#include <startup.h>
+#include <system_info.h>
+
+static struct system_info_identity identity;
+static const char* identityError;
+
+const char* ffPyxisIdentityError(void) {
+    return identityError;
+}
+
+const char* ffPyxisOSName(void) {
+    return identity.os_name;
+}
+
+void ffPlatformInit(FFPlatform* platform) {
+    *platform = (FFPlatform) {};
+    ffStrbufInit(&platform->homeDir);
+    ffStrbufInit(&platform->cacheDir);
+    ffListInit(&platform->configDirs);
+    ffListInit(&platform->dataDirs);
+    ffStrbufInit(&platform->exePath);
+    ffStrbufInit(&platform->cwd);
+    ffStrbufInit(&platform->userName);
+    ffStrbufInit(&platform->fullUserName);
+    ffStrbufInit(&platform->hostName);
+    ffStrbufInit(&platform->userShell);
+
+    FFPlatformSysinfo* info = &platform->sysinfo;
+    ffStrbufInit(&info->name);
+    ffStrbufInit(&info->release);
+    ffStrbufInit(&info->version);
+    ffStrbufInit(&info->architecture);
+    info->pageSizeShift = (uint32_t) __builtin_ctzll(MEMORY_PAGE_SIZE);
+
+    identity = (struct system_info_identity) {};
+    handle_t handle = startup_resource("system_info");
+    if (handle == HANDLE_INVALID) {
+        identityError = "Missing system_info READ grant";
+        return;
+    }
+    if (system_info_get_identity(handle, &identity) != CALL_OK) {
+        identityError = "Native system identity query failed";
+        return;
+    }
+    if (!identity.os_name[0] || !identity.kernel_name[0] || !identity.architecture[0]) {
+        identityError = "Native system identity is incomplete";
+        return;
+    }
+    identityError = nullptr;
+    ffStrbufSetS(&info->name, identity.kernel_name);
+    ffStrbufSetS(&info->release, identity.build_revision);
+    ffStrbufSetS(&info->architecture, identity.architecture);
+}
+
+void ffPlatformDestroy(FFPlatform* platform) {
+    ffStrbufDestroy(&platform->homeDir);
+    ffStrbufDestroy(&platform->cacheDir);
+    FF_LIST_FOR_EACH (FFstrbuf, dir, platform->configDirs) {
+        ffStrbufDestroy(dir);
+    }
+    ffListDestroy(&platform->configDirs);
+    FF_LIST_FOR_EACH (FFstrbuf, dir, platform->dataDirs) {
+        ffStrbufDestroy(dir);
+    }
+    ffListDestroy(&platform->dataDirs);
+    ffStrbufDestroy(&platform->exePath);
+    ffStrbufDestroy(&platform->cwd);
+    ffStrbufDestroy(&platform->userName);
+    ffStrbufDestroy(&platform->fullUserName);
+    ffStrbufDestroy(&platform->hostName);
+    ffStrbufDestroy(&platform->userShell);
+    ffStrbufDestroy(&platform->sysinfo.name);
+    ffStrbufDestroy(&platform->sysinfo.release);
+    ffStrbufDestroy(&platform->sysinfo.version);
+    ffStrbufDestroy(&platform->sysinfo.architecture);
+}
