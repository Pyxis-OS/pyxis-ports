prefix=sdk://
libdir=${prefix}/lib
includedir=${prefix}/include

Name: blurgtext
Description: Static blurgtext with its bundled shaping and font libraries
Version: 0.e11c19f
Requires.private: libcxx
Libs: -L${libdir} -Wl,--start-group -lblurgtext -lraqm -lsheenbidi -lunibreak -lplutosvg -lplutovg -lharfbuzz -lfreetype -Wl,--end-group
Cflags: -I${includedir}
