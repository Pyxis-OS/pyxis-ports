diff --git a/CMakeLists.txt b/CMakeLists.txt
index 60d0000..95f6068 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,14 +12,23 @@ else()
     set(BT_BUILD_FTHB_DEFAULT OFF)
 endif()
 option(BT_BUILD_FTHB "Build statically linked freetype+harfbuzz" ${BT_BUILD_FTHB_DEFAULT})
+set(BT_FTHB_CMAKE_ARGS "" CACHE STRING "Additional CMake arguments for bundled FreeType/Harfbuzz")
 
-add_library(blurgtext SHARED
+option(BT_BUILD_SHARED "Build blurgtext as a shared library" ON)
+if(BT_BUILD_SHARED)
+    set(BT_LIBRARY_TYPE SHARED)
+else()
+    set(BT_LIBRARY_TYPE STATIC)
+endif()
+
+add_library(blurgtext ${BT_LIBRARY_TYPE}
     src/blurgtext.c
     src/hashmap.c
     src/glyphatlas.c
     src/fontmanager.c
     src/font.c
     src/util.c
+    src/sysfonts_pyxis.c
     src/sysfonts_fontconfig.c
     src/sysfonts_directwrite.cpp
     src/sysfonts_coretext.cpp
@@ -44,6 +53,8 @@ if(BT_ENABLE_SYSTEMFONTS)
         #enable directwrite (both mingw and MSVC)
         target_compile_definitions(blurgtext PRIVATE -DBT_ENABLE_DIRECTWRITE=1)
         target_link_libraries(blurgtext PRIVATE gdi32 dwrite)
+    elseif(CMAKE_SYSTEM_NAME STREQUAL "Pyxis")
+        target_compile_definitions(blurgtext PRIVATE BT_ENABLE_PYXIS=1)
     elseif(APPLE)
         target_compile_definitions(blurgtext PRIVATE -DBT_ENABLE_CORETEXT=1)
     elseif(UNIX)
@@ -135,6 +146,7 @@ if(BT_BUILD_FTHB)
         -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
         -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}
         -DFT_DOWNLOADS_DIR=${FT_DOWNLOADS_DIR}
+        ${BT_FTHB_CMAKE_ARGS}
         -G ${CMAKE_GENERATOR}
     )
     ExternalProject_Get_Property(FTHB INSTALL_DIR)
