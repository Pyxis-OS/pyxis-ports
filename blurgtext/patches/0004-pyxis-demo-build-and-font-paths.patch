 static blurg_font_t* loadFont(blurg_t *blurg, const char *filename)
 {
+#ifdef __pyxis__
+    char path[1000];
+    const char *directory = !strcmp(filename, "EmojiOneColor.otf") ? "emojione-color" : "roboto";
+    int length = snprintf(path, sizeof(path), "pkg://fonts/%s/%s", directory, filename);
+    if(length < 0 || (size_t)length >= sizeof(path))
+        return NULL;
+    return blurg_font_add_file(blurg, path);
+#else
     char *basePath = SDL_GetBasePath();
     char path[1000];
     snprintf(path, 1000, "%s/%s", basePath, filename);
     SDL_free(basePath);
     return blurg_font_add_file(blurg, path);
+#endif
 }
 
