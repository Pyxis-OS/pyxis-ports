@@ -588,6 +595,26 @@ char *Bstrupr(char *s)
 
 #define BMAXPAGESIZE 16384
 
+#if defined __pyxis__
+int32_t Bread_whole(int fd, void *buffer, bsize_t count)
+{
+    bsize_t total = 0;
+
+    while (total < count)
+    {
+        ssize_t const got = read(fd, (char *)buffer + total, count - total);
+
+        if (got < 0)
+            return total ? (int32_t)total : -1;
+        if (got == 0)
+            break;
+        total += got;
+    }
+
+    return (int32_t)total;
+}
+#endif
+
 int Bgetpagesize(void)
 {
