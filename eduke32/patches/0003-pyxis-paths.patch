diff --git a/source/build/src/vfs.cpp b/source/build/src/vfs.cpp
index 141409e..6de050d 100644
--- a/source/build/src/vfs.cpp
+++ b/source/build/src/vfs.cpp
@@ -13,6 +13,107 @@
 #include "osd.h"
 #include "pragmas.h"
 #include "vfs.h"
+
+#if defined(__pyxis__)
+#include <errno.h>
+#include <unistd.h>
+
+// The port's working directory; empty until buildvfs_chdir, when relative
+// names resolve as libc resolves them.
+static char pyxis_cwd[BMAX_PATH];
+
+char const *buildvfs_resolve(char const *path, char *buf, size_t size)
+{
+    int length;
+
+    if (Bstrstr(path, "://"))
+        length = Bsnprintf(buf, size, "%s", path);
+    else if (pyxis_cwd[0])
+        length = Bsnprintf(buf, size, "%s/%s", pyxis_cwd, path);
+    else
+        return path;
+
+    if (length < 0 || (size_t)length >= size)
+        return path;
+
+    // The engine builds names such as ./ and dir///; collapse them, and drop a
+    // trailing slash unless it ends the root.
+    Bcorrectfilename(buf, 0);
+    size_t end = Bstrlen(buf);
+    if (end > 0 && buf[end - 1] == '/' && !(end >= 3 && buf[end - 2] == '/' && buf[end - 3] == ':'))
+        buf[end - 1] = 0;
+
+    return buf;
+}
+
+int buildvfs_pyxis_chdir(char const *dir)
+{
+    char buf[BMAX_PATH];
+    char const *path = buildvfs_resolve(dir, buf, sizeof(buf));
+    struct Bstat st;
+
+    if (Bstat(path, &st) < 0)
+        return -1;
+    if (!(st.st_mode & S_IFDIR))
+    {
+        errno = ENOTDIR;
+        return -1;
+    }
+    if (Bstrlen(path) >= sizeof(pyxis_cwd))
+    {
+        errno = ERANGE;
+        return -1;
+    }
+    Bstrcpy(pyxis_cwd, path);
+    return 0;
+}
+
+char *buildvfs_pyxis_getcwd(char *buf, size_t size)
+{
+    if (!pyxis_cwd[0])
+    {
+        errno = ENOENT;
+        return NULL;
+    }
+    if (Bstrlen(pyxis_cwd) >= size)
+    {
+        errno = ERANGE;
+        return NULL;
+    }
+    return Bstrcpy(buf, pyxis_cwd);
+}
+
+FILE *buildvfs_pyxis_fopen(char const *path, char const *mode)
+{
+    char buf[BMAX_PATH];
+    return fopen(buildvfs_resolve(path, buf, sizeof(buf)), mode);
+}
+
+int buildvfs_pyxis_open(char const *path, int flags)
+{
+    char buf[BMAX_PATH];
+    // Native creation has no permission bits; libc accepts only 0666.
+    return open(buildvfs_resolve(path, buf, sizeof(buf)), flags, 0666);
+}
+
+int buildvfs_pyxis_stat(char const *path, struct Bstat *st)
+{
+    char buf[BMAX_PATH];
+    return Bstat(buildvfs_resolve(path, buf, sizeof(buf)), st);
+}
+
+int buildvfs_pyxis_mkdir(char const *path)
+{
+    char buf[BMAX_PATH];
+    return mkdir(buildvfs_resolve(path, buf, sizeof(buf)), 0);
+}
+
+int buildvfs_pyxis_unlink(char const *path)
+{
+    char buf[BMAX_PATH];
+    return unlink(buildvfs_resolve(path, buf, sizeof(buf)));
+}
+#endif
 #include "cache1d.h"
 
