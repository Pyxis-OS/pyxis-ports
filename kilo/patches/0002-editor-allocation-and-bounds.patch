+/* Cursor offsets count source bytes; drawing and search count expanded tabs. */
+static int rendered_column(erow *row, int column) {
+    int rendered = 0;
+    for (int i = 0; i < column && i < row->size; i++) {
+        rendered++;
+        if (row->chars[i] == TAB)
+            while (rendered % 8) rendered++;
+    }
+    return rendered;
+}
+
+static int source_column(erow *row, int rendered) {
+    int column = 0, width = 0;
+    while (column < row->size && width < rendered) {
+        width++;
+        if (row->chars[column] == TAB)
+            while (width % 8) width++;
+        column++;
+    }
+    return column;
+}
