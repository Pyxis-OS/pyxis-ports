 /* ======================= Low level terminal handling ====================== */
 
+static uint64_t terminal_generation;
+static int terminal_ready;
+
+static void restore_terminal(void) {
+    if (!terminal_ready) return;
+    const char sequence[] = "\x1b[0m\x1b[?25h\x1b[?1049l";
+    write(STDOUT_FILENO,sequence,sizeof(sequence)-1);
+    terminal_ready = 0;
+}
+
+/* Signals are not supplied yet: observe resize beside readable input without
+ * consuming bytes through borrowed handles or restarting an Escape timeout. */
+static int terminal_read(int fd, char *byte, size_t count) {
+    struct pyxis_descriptor_binding input, output;
+    struct timespec now;
+    if (pyxis_descriptor_borrow(fd,&input) < 0 ||
+        pyxis_descriptor_borrow(STDOUT_FILENO,&output) < 0 ||
+        clock_gettime(CLOCK_MONOTONIC,&now) < 0) exit(1);
+    uint64_t deadline = (uint64_t)now.tv_sec*UINT64_C(1000000000) +
+                        now.tv_nsec + UINT64_C(100000000);
+    for (;;) {
+        struct wait_interest interests[] = {
+            {.handle = input.handle, .events = WAIT_READABLE},
+            {.handle = output.handle, .events = WAIT_RESIZED,
+             .observed_generation = terminal_generation},
+        };
+        uint64_t events[2] = {0};
+        enum call_status status = wait_many(interests,2,
+                                            input.buffered_read ? 0 : deadline,events);
+        if (status == CALL_TIMED_OUT && !input.buffered_read) return 0;
+        if ((status != CALL_OK && status != CALL_TIMED_OUT) ||
+            (events[1] & (WAIT_CLOSED | WAIT_ERROR))) exit(1);
+        if (events[1] & WAIT_RESIZED) {
+            updateWindowSize();
+            editorRefreshScreen();
+        }
+        if (input.buffered_read ||
+            (events[0] & (WAIT_READABLE | WAIT_PEER_FIN | WAIT_CLOSED | WAIT_ERROR))) {
+            int nread = read(fd,byte,count);
+            if (nread < 0) exit(1);
+            if (!nread && (events[0] & WAIT_PEER_FIN)) {
+                if (E.dirty) fprintf(stderr,"kilo: terminal input closed; unsaved edits lost\n");
+                exit(E.dirty ? EXIT_FAILURE : EXIT_SUCCESS);
+            }
+            if (nread && *byte == '\n') *byte = '\r'; /* Pyxis Enter is LF. */
+            return nread;
+        }
+    }
+}
