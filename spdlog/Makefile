include $(SDK)/share/pyxis.mk
CMAKE_PYXIS_CXXFLAGS := $(filter-out -MMD -MP,$(PYXIS_CXXFLAGS))

.PHONY: all
all:
	cmake -S $(SOURCE) -B $(BUILD) -G "Unix Makefiles" \
	  -DCMAKE_TOOLCHAIN_FILE=$(PYXIS_SDK)/share/pyxis.cmake \
	  -DPYXIS_CROSS_COMPILE=$(CROSS_COMPILE) \
	  -DCMAKE_CXX_FLAGS="$(CMAKE_PYXIS_CXXFLAGS)" \
	  -DCMAKE_CXX_STANDARD=23 -DCMAKE_CXX_STANDARD_REQUIRED=ON \
	  -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE=-DNDEBUG \
	  -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_INCLUDEDIR=include \
	  -DBUILD_SHARED_LIBS=OFF -DSPDLOG_BUILD_SHARED=OFF \
	  -DSPDLOG_INSTALL=ON -DSPDLOG_BUILD_ALL=OFF \
	  -DSPDLOG_BUILD_EXAMPLE=OFF -DSPDLOG_BUILD_EXAMPLE_HO=OFF \
	  -DSPDLOG_BUILD_TESTS=OFF -DSPDLOG_BUILD_TESTS_HO=OFF \
	  -DSPDLOG_BUILD_BENCH=OFF -DSPDLOG_ENABLE_PCH=OFF \
	  -DSPDLOG_FMT_EXTERNAL=OFF -DSPDLOG_FMT_EXTERNAL_HO=OFF \
	  -DSPDLOG_USE_STD_FORMAT=OFF -DSPDLOG_NO_EXCEPTIONS=OFF \
	  -DSPDLOG_PREVENT_CHILD_FD=OFF -DSPDLOG_CLOCK_COARSE=OFF \
	  -DSPDLOG_FWRITE_UNLOCKED=OFF -DSPDLOG_NO_THREAD_ID=OFF \
	  -DSPDLOG_NO_TLS=OFF -DSPDLOG_NO_ATOMIC_LEVELS=OFF \
	  -DFETCHCONTENT_FULLY_DISCONNECTED=ON
	$(MAKE) -C $(BUILD)
