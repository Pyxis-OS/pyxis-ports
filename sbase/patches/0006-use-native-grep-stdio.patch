@@ -59,6 +60,27 @@ addpattern(const char *pattern)
 	}
 }
 
+/* Each line of TEXT is a pattern, as when read from a file; the part after
+ * the last newline counts even when empty. */
+static void
+addpatterntext(const char *text)
+{
+	char *line;
+	const char *end;
+
+	for (;;) {
+		end = strchr(text, '\n');
+		if (!end)
+			end = text + strlen(text);
+		line = enstrndup(Error, text, end - text);
+		addpattern(line);
+		free(line);
+		if (!*end)
+			break;
+		text = end + 1;
+	}
+}
+
