 static char mode = 'n';
 
+/* Pyxis: -F reopens NAME when it names a different file than the one followed.
+ * Identity needs st_dev and st_ino from both sides; without them a replacement
+ * cannot be proven and the open file is kept. */
+static int
+replaced(const struct stat *open, const struct stat *named)
+{
+	const uint64_t identity = STAT_DEV_VALID | STAT_INO_VALID;
+
+	if ((open->st_valid & identity) != identity ||
+	    (named->st_valid & identity) != identity)
+		return 0;
+	return open->st_dev != named->st_dev || open->st_ino != named->st_ino;
+}
