+/*
+ * Pyxis: with only -c, a value in the input pipe is counted from its size
+ * without reading it. fread_some stops at the next value, so each byte run is
+ * read and counted as before.
+ */
+static void
+wcbytes(FILE *fp, const char *str)
+{
+	char buf[BUFSIZ];
+	struct stat st;
+	handle_t value;
+	size_t nc = 0, n;
+	int fd, r;
+
+	for (;;) {
+		if ((r = pyxis_input_take(fp, &value)) < 0)
+			eprintf("%s:", str ? str : "<stdin>");
+		if (r) {
+			if ((fd = pyxis_descriptor_adopt(&value, PYXIS_DESCRIPTOR_READ)) < 0 ||
+			    fstat(fd, &st) < 0)
+				eprintf("%s:", str ? str : "<stdin>");
+			nc += st.st_size;
+			close(fd);
+			continue;
+		}
+		if (!(n = fread_some(buf, sizeof(buf), fp)))
+			break;
+		nc += n;
+	}
+	if (ferror(fp))
+		eprintf("%s:", str ? str : "<stdin>");
+	tc += nc;
+	output(str, nc, 0, 0);
+}
