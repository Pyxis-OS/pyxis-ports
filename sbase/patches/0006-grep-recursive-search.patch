+static int
+isdirectory(const char *path)
+{
+	struct stat st;
+
+	return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+/* DIR/NAME; an empty DIR gives just NAME. */
+static char *
+joinpath(const char *dir, const char *name)
+{
+	size_t dirlen = strlen(dir);
+	size_t namelen = strlen(name);
+	int slash = dirlen && dir[dirlen - 1] != '/';
+	char *path = enmalloc(Error, dirlen + slash + namelen + 1);
+
+	memcpy(path, dir, dirlen);
+	if (slash)
+		path[dirlen] = '/';
+	memcpy(path + dirlen + slash, name, namelen + 1);
+	return path;
+}
+
+struct dirname {
+	char *name;
+	int directory;
+};
+
+static int
+dirnamecmp(const void *a, const void *b)
+{
+	return strcmp(((const struct dirname *)a)->name,
+	              ((const struct dirname *)b)->name);
+}
+
+static int
+grepfile(const char *path)
+{
+	FILE *fp;
+	int m;
+
+	if (!(fp = fopen(path, "r"))) {
+		if (!sflag)
+			weprintf("fopen %s:", path);
+		return Error;
+	}
+	m = grep(fp, path);
+	if (fshut(fp, path))
+		m = Error;
+	return m;
+}
+
+static int
+combine(int match, int m)
+{
+	if (m == Error || (match != Error && m == Match))
+		return m;
+	return match;
+}
+
+/* Searches every file below PATH in byte order of the names the native listing
+ * returned, descending where a subdirectory sorts. Symbolic links are not
+ * followed. The listing is read and closed before descending, so open handles
+ * do not grow with depth. An empty PATH is the working directory, whose files
+ * are named without a prefix. */
+static int
+grepdir(const char *path, int depth)
+{
+	struct dirname *names = NULL;
+	struct dirent *ent;
+	DIR *dp;
+	size_t count = 0, cap = 0, i;
+	char *child;
+	int match = NoMatch, m;
+
+	if (!(dp = opendir(*path ? path : "."))) {
+		if (!sflag)
+			weprintf("opendir %s:", *path ? path : ".");
+		return Error;
+	}
+	for (;;) {
+		errno = 0;
+		if (!(ent = readdir(dp)))
+			break;
+		if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, ".."))
+			continue;
+		if (ent->d_type == DT_LNK)
+			continue;
+		if (count == cap) {
+			cap = cap ? cap * 2 : 16;
+			names = enreallocarray(Error, names, cap, sizeof(*names));
+		}
+		names[count].name = enstrdup(Error, ent->d_name);
+		names[count].directory = ent->d_type == DT_DIR;
+		if (ent->d_type == DT_UNKNOWN) {
+			child = joinpath(path, ent->d_name);
+			names[count].directory = isdirectory(child);
+			free(child);
+		}
+		count++;
+	}
+	if (errno) {
+		weprintf("readdir %s:", *path ? path : ".");
+		match = Error;
+	}
+	closedir(dp);
+
+	qsort(names, count, sizeof(*names), dirnamecmp);
+	for (i = 0; i < count; i++) {
+		child = joinpath(path, names[i].name);
+		if (names[i].directory && depth + 1 >= RECURSE_DEPTH_LIMIT) {
+			weprintf("%s: deeper than %d levels; not searched\n",
+			         child, RECURSE_DEPTH_LIMIT);
+			m = Error;
+		} else if (names[i].directory) {
+			m = grepdir(child, depth + 1);
+		} else {
+			m = grepfile(child);
+		}
+		match = combine(match, m);
+		free(child);
+		free(names[i].name);
+	}
+	free(names);
+	return match;
+}
