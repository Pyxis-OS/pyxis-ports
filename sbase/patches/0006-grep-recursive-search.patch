+/* Stdio output is unbuffered, so every printf or puts is a native write.
+ * Output is collected here and written in blocks; grep() flushes after each
+ * line when reading stdin, and at the end of each file. */
+static char outbuf[BUFSIZ];
+static size_t outlen;
+
+static void
+flushout(void)
+{
+	if (outlen)
+		fwrite(outbuf, 1, outlen, stdout);
+	outlen = 0;
+}
+
+static void
+putout(const char *s, size_t len)
+{
+	size_t n;
+
+	while (len) {
+		if (outlen == sizeof(outbuf))
+			flushout();
+		n = MIN(len, sizeof(outbuf) - outlen);
+		memcpy(outbuf + outlen, s, n);
+		outlen += n;
+		s += n;
+		len -= n;
+	}
+}
+
+static void
+putname(const char *str)
+{
+	putout(str, strlen(str));
+	putout(":", 1);
+}
+
+static void
+putnumber(long n, char end)
+{
+	char text[32];
+	int len = snprintf(text, sizeof(text), "%ld%c", n, end);
+
+	putout(text, len);
+}
