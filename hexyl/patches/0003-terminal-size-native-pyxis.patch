@@ -0,0 +1,38 @@
+use super::{Height, Width};
+
+#[repr(C)]
+struct ConsoleSizeReply {
+    columns: u64,
+    rows: u64,
+    generation: u64,
+}
+
+unsafe extern "C" {
+    fn pyxis_terminal_get_size(descriptor: i32, size: *mut ConsoleSizeReply) -> i32;
+}
+
+/// Queries the supplied stdout, stderr, then stdin; no ambient terminal lookup.
+pub fn terminal_size() -> Option<(Width, Height)> {
+    const STDOUT: i32 = 1;
+    const STDERR: i32 = 2;
+    const STDIN: i32 = 0;
+    for descriptor in [STDOUT, STDERR, STDIN] {
+        let mut size = ConsoleSizeReply {
+            columns: 0,
+            rows: 0,
+            generation: 0,
+        };
+        // The native call writes this fixed-size reply and retains no pointer.
+        if unsafe { pyxis_terminal_get_size(descriptor, &mut size) } != 0 {
+            continue;
+        }
+        if let (Ok(columns), Ok(rows)) =
+            (u16::try_from(size.columns), u16::try_from(size.rows))
+        {
+            if columns > 0 && rows > 0 {
+                return Some((Width(columns), Height(rows)));
+            }
+        }
+    }
+    None
+}
